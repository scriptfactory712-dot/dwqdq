    local lastHideFire = 0
    local function tryAutoHide()
        -- Полный запрет автоматического входа в шкафы/кровати по запросу пользователя.
        if not AUTO_HIDE_ALLOWED then return end
        if not autoHideEnabled and not (bdRuntime.autoHide and getFloor() == 0) then return end
        if os.clock() - lastHideFire < 3 then return end
        local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local bestPrompt, bestD = nil, math.huge
        for _, room in ipairs(getNearbyRooms()) do
            for _, v in ipairs(getRoomPrompts(room)) do
                if v.Parent then
                    local mn = v.Parent.Name
                    for _, h in ipairs(HSListGlobal) do
                        if mn == h then
                            local promptPos = promptWorldPosition(v)
                            local d = promptPos and (promptPos - root.Position).Magnitude or math.huge
                            if d < bestD then bestD, bestPrompt = d, v end
                            break
                        end
                    end
                end
            end
        end
        if bestPrompt and bestD <= 60 then
            if not FirePrompt(bestPrompt, "autoHide") then return end
            lastHideFire = os.clock()
            Rayfield:Notify({Title = "🚪 Auto-Hide", Content = "Прячемся! шкаф " .. math.floor(bestD) .. "m", Duration = 2})
        end
    end

