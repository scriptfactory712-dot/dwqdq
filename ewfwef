    -- ФИЛЬТРЫ КАЧЕСТВА: не подсвечиваем гигантские части (земля/дороги/скалы) и служебные модели
    local OD_BLOCK_WORDS = {"door", "frame", "spawn", "clone", "wall", "floor", "ground", "terrain", "rock", "cave", "tunnel", "stair", "fence", "roof", "decor", "hitbox", "room", "waypoint", "pathfinding", "navnode"}
    local function odBlocked(ln, extra)
        for _, w in ipairs(OD_BLOCK_WORDS) do
            if ln:find(w) then return true end
        end
        if extra then
            for _, w in ipairs(extra) do
                if ln:find(w) then return true end
            end
        end
        return false
    end
    local function odSmall(model, maxSize)
        local ok, size = pcall(function() return model:GetExtentsSize() end)
        if not ok or not size then return true end
        return size.Magnitude <= (maxSize or 14)
    end

    -- применение ESP к модели (монстры/объекты — с именем, предметы/тропы — только подсветка)
    local function odApply(model)
        if not model or not model:IsA("Model") or not model.Parent then return end
        local ln = string.lower(model.Name)
        local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        if not part then return end

        -- Обычные проходные двери обрабатывает только последовательный door-tracker ниже.
        -- Так общий скан не показывает дальние двери раньше времени.
        if odIsRegularDoorName(model.Name) then return end

        if ln:find("spawn") or ln:find("template") or ln:find("placeholder")
            or ln:find("hitbox") or ln:find("collision") or ln:find("trigger")
            or ln:find("waypoint") or ln:find("pathnode") then
            return
        end

        -- Известные объекты проверяем строгими классификаторами. Если тип выключен,
        -- объект всё равно не проваливается в общий Items ESP как ложное срабатывание.
        for _, o in ipairs(OD_OBJ) do
            if o.test(model.Name) then
                if odEnabled[o.key] then ManageESP(model, part, o.label, o.key, o.big == true) end
                return
            end
        end

        for _, m in ipairs(OD_MON) do
            if odEnabled[m.key] and odMatchAny(ln, m.pats) then
                if m.hl then
                    ManageHighlight(model, part, m.key)
                else
                    ManageESP(model, part, m.label, m.key, true)
                end
                if m.key == "odSurge" then surgeLastSeen = os.clock() end
                return
            end
        end
        for _, h in ipairs(OD_HL_EXTRA) do
            if h.test(model.Name) then
                if odEnabled[h.key] and not odBlocked(ln) and odSmall(model, h.maxSize) then
                    ManageHighlight(model, part, h.key, true)
                end
                return
            end
        end
        local normName = odNorm(model.Name)
        local isGold = normName:match("^goldpile%d*$") or normName:match("^coinpile%d*$") or normName:match("^gold%d*$")
        if odEnabled.odGold and isGold and odSmall(model, 30) then
            ManageHighlight(model, part, "odGold", true)
            return
        end
        if odEnabled.odKeyItems and odMatchesNamedItem(model.Name, OD_ITEM_KEY) and odSmall(model, 16) and not odBlocked(ln) then
            ManageHighlight(model, part, "odKeyItems", true)
            return
        end
        if odEnabled.odItems and odMatchesNamedItem(model.Name, OD_ITEM_ALL) and odSmall(model, 14) and not odBlocked(ln) then
            ManageHighlight(model, part, "odItems", true)
            return
        end
        if odEnabled.odPath and odIsPathName(model.Name) and odSmall(model, 26) and not odBlocked(ln) then
            ManageHighlight(model, part, "odPath", true)
            return
        end
    end

    -- Реальная проходная калитка Outdoors имеет структуру
    -- CurrentRooms/<номер комнаты>/Door. Внутри находятся Hinge, деталь Door и
    -- события открытия. Детали с именем Door внутри шкафов/тумбочек/столов сюда
    -- намеренно не допускаются: поиск BasePart по одному имени давал ложные ESP.
    local function odDoorCandidate(instance)
        if not instance or not instance:IsA("Model") or not odIsRegularDoorName(instance.Name) then
            return nil, nil
        end

        local room = instance.Parent
        if not room or not room:IsA("Model") or not tonumber(room.Name)
            or not room.Parent or room.Parent.Name ~= "CurrentRooms" then
            return nil, nil
        end

        local doorPart = instance:FindFirstChild("Door")
        local hinge = instance:FindFirstChild("Hinge")
        local hasOpenControl = instance:FindFirstChild("ClientOpen")
            or instance:FindFirstChild("Func_Open")
            or instance:FindFirstChild("Func_ForceOpen")

        -- Проверяем сигнатуру самой проходной калитки. Это одновременно отсекает
        -- декор, DrawerDoors и любые мебельные створки, даже если их назвали Door.
        if not doorPart or not doorPart:IsA("BasePart") then return nil, nil end
        if not hinge or not hinge:IsA("BasePart") or not hasOpenControl then return nil, nil end

        return instance, doorPart
    end

    local function odFindNextDoor()
        local currentRoom = getCurrentRoom()
        local cr = workspace:FindFirstChild("CurrentRooms")
        local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not cr or not root then return nil, nil end

        local revealDistance = math.min(tonumber(odRadius) or 70, 65)
        local bestModel, bestPart, bestScore = nil, nil, math.huge
        local checked = {}

        for _, room in ipairs(cr:GetChildren()) do
            local rn = tonumber(room.Name)
            if room:IsA("Model") and (currentRoom <= 0 or not rn or math.abs(rn - currentRoom) <= 1) then
                for _, instance in ipairs(room:GetDescendants()) do
                    local model, part = odDoorCandidate(instance)
                    if model and part and part.Parent and not checked[model] and not odPassedDoors[model] then
                        checked[model] = true
                        local ownerRoom, targetId = odRoomNumberFor(model)
                        local valid = true
                        local scoreBias = 0

                        if currentRoom > 0 and targetId then
                            if targetId == currentRoom + 1 then
                                scoreBias = -100
                            elseif targetId <= currentRoom or targetId > currentRoom + 1 then
                                valid = false
                            end
                        elseif currentRoom > 0 and ownerRoom then
                            -- Без RoomID берём только выход текущей комнаты, не дверь из предзагруженной дальней.
                            if ownerRoom == currentRoom then
                                scoreBias = -30
                            else
                                valid = false
                            end
                        end

                        local rel = part.Position - root.Position
                        local dist = rel.Magnitude
                        local facing = dist > 0.1 and rel.Unit:Dot(root.CFrame.LookVector) or 1
                        if facing < -0.35 then valid = false end
                        if valid and dist <= revealDistance then
                            local score = dist + scoreBias
                            if score < bestScore then
                                bestModel, bestPart, bestScore = model, part, score
                            end
                        end
                    end
                end
            end
        end
        return bestModel, bestPart
    end

    task.spawn(function()
