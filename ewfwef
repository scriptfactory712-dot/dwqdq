local function arrowTo(pos)
    -- FIX: камера могла отсутствовать/смениться после инжекта.
    local cam = Camera
    if (not cam or not cam.Parent) and workspace then
        pcall(function() cam = workspace.CurrentCamera end)
        if cam then Camera = cam end
    end
    if not cam or not pos then return "•" end
    local rel = cam.CFrame:PointToObjectSpace(pos)
    local fx = rel.X
    local fz = -rel.Z
    if math.abs(fz) > math.abs(fx) then
        return fz < 0 and "↑" or "↓"
    else
        return fx < 0 and "←" or "→"
    end
end

-- FIX утечки тегов: ManageHighlight вешает ДВА инстанса с именем M4_HL_<type>
-- (Highlight + BoolValue), а все очистки через FindFirstChild сносили только
-- ОДИН. Остаток навсегда блокировал повторную подсветку модели (дедуп по
-- префиксу M4_HL_) и тёк каждым вытеснением. Сносим ВСЕ совпадения.
local function clearModelTags(model, typeKey)
    if not model then return end
    local ok, kids = pcall(function() return model:GetChildren() end)
    if not ok or type(kids) ~= "table" then return end
    for _, c in ipairs(kids) do
        local match = false
        if typeKey ~= nil then
            match = (c.Name == "M4_HL_" .. typeKey)
        elseif type(c.Name) == "string" then
            match = (c.Name:find("M4_HL_", 1, true) ~= nil)
        end
        if match then
            pcall(function() c:Destroy() end)
        end
    end
end

local function ClearESPType(typeKey)
    for i = #ActiveESPs, 1, -1 do
        local esp = ActiveESPs[i]
        if esp.Type == typeKey or typeKey == "all" then
            if esp.Billboard then esp.Billboard:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            if esp.Model then
                if typeKey == "all" then
                    local ok, kids = pcall(function() return esp.Model:GetChildren() end)
                    if ok and type(kids) == "table" then
                        for _, c in ipairs(kids) do
                            if type(c.Name) == "string" and c.Name:find("M4_HL_", 1, true) then
                                pcall(function() c:Destroy() end)
                            end
                        end
                    end
                else
                    clearModelTags(esp.Model, esp.Type)
                end
            end
            table.remove(ActiveESPs, i)
        end
    end
end

