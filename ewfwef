        end)
    else
        fpsRestoreFX()
        pcall(function()
            if origGraphics.shadows ~= nil then Lighting.GlobalShadows = origGraphics.shadows end
            if origGraphics.tech ~= nil then Lighting.Technology = origGraphics.tech end
        end)
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
    end
