        local function normalize(value)
            return string.lower(tostring(value or "")):gsub("[^%w]", "")
        end
        local function partOf(object)
            if object:IsA("BasePart") then return object end
            if object:IsA("Model") then return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true) end
            if object:IsA("Tool") then return object:FindFirstChild("Handle") or object:FindFirstChildWhichIsA("BasePart", true) end
            return object:FindFirstChildWhichIsA("BasePart", true)
        end
        local function classify(object)
            local names = {object.Name}
            pcall(function()
                for _, attributeName in ipairs({"RawName", "EntityName", "EntityType", "ItemName", "ObjectName"}) do
                    local value = object:GetAttribute(attributeName)
                    if value ~= nil then names[#names + 1] = value end
                end
            end)
            for _, value in ipairs(names) do
                local named = entityNames[normalize(value)]
                if named then return "entity", named end
                named = mechanicNames[normalize(value)]
                if named then return "mechanic", named end
                named = largeNames[normalize(value)]
                if named then return "large", named end
            end
            local tagged = false
            pcall(function()
                tagged = object:GetAttribute("LargeItem") == true or object:GetAttribute("IsLargeItem") == true
                    or CollectionService:HasTag(object, "LargeItem") or CollectionService:HasTag(object, "StairwellLargeItem")
            end)
            if tagged then return "large", {kind = "largeItems", typeKey = "swScrapMetal"} end
            return nil, nil
        end
        local function canonical(object, group, config)
            local best = object
            local current = object.Parent
            for _ = 1, 5 do
                if not current or current == workspace then break end
                local parentGroup, parentConfig = classify(current)
                if parentGroup == group and parentConfig.kind == config.kind then best = current end
                current = current.Parent
            end
            return best
        end
        local function enabledFor(record)
            if record.group == "large" then
                return S.enabled.largeItems or S.enabled[record.config.kind]
            end
            return S.enabled[record.config.kind]
        end
        local function applyRecord(object, record)
            if not object.Parent or not record.part or not record.part.Parent or not enabledFor(record) then return end
            if record.group == "large" or record.config.kind == "meld" then
                -- Large carried items и MELD — только контур/подсветка, без надписи.
                ManageHighlight(object, record.part, record.config.typeKey, true)
            else
                ManageESP(object, record.part, record.config.label, record.config.typeKey, true)
            end
        end
        local function remember(object)
            if not object or not object.Parent then return end
            local group, config = classify(object)
            if not group then return end
            object = canonical(object, group, config)
            local part = partOf(object)
            if not part then return end
            local record = {group = group, config = config, part = part}
            S.records[object] = record
            if group == "entity" then S.entities[object] = record end
            if getFloor() == 5 then applyRecord(object, record) end
        end
        local function clearAll()
            for _, typeKey in ipairs(stairTypes) do ClearESPType(typeKey) end
        end
        local function rebuild()
            clearAll()
            if getFloor() ~= 5 then return end
            for object, record in pairs(S.records) do applyRecord(object, record) end
        end
        local function scanExisting()
            S.records = setmetatable({}, {__mode = "k"})
            S.entities = setmetatable({}, {__mode = "k"})
            local rooms = workspace:FindFirstChild("CurrentRooms")
            if rooms then
                remember(rooms)
                for _, object in ipairs(rooms:GetDescendants()) do remember(object) end
            end
            for _, containerName in ipairs({"Entities", "Monsters", "SpawnedEntities"}) do
                local container = workspace:FindFirstChild(containerName)
                if container then
                    remember(container)
                    for _, object in ipairs(container:GetDescendants()) do remember(object) end
                end
            end
            for _, object in ipairs(workspace:GetChildren()) do remember(object) end
            rebuild()
        end
