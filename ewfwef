    local function isVacuumDoorPrompt(prompt)
        -- Главный выход комнаты остаётся безопасным даже в шаблоне комнаты,
        -- имя RawName которой содержит Vacuum. Опасны только боковые двери.
        if mainRoomDoorForPrompt(prompt) then return false end
        return hasVacuumMarker(prompt)
    end

    local function isDoorPrompt(prompt)
        if DoorAssist.protected(prompt) or isVacuumDoorPrompt(prompt) then return false end
        return mainRoomDoorForPrompt(prompt) ~= nil
