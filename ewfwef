-- ==== PERF: батчер синхронных сигналов ====
-- При открытии двери стриминг сыплет тысячи DescendantAdded; разбор каждого
-- синхронно = фриз 1-3с на телефоне. Кладём в очередь с адаптивным бюджетом кадра.
local batchQ, batchHead, batchTail, batchBusy = {}, 1, 0, false
local function batchEnqueue(fn)
    batchTail = batchTail + 1
    batchQ[batchTail] = fn
    if batchBusy then return end
    batchBusy = true
    task.spawn(function()
        while HubActive do
            local t0 = os.clock()
            while batchHead <= batchTail and (os.clock() - t0) < PERF.batchSlice do
                local fn = batchQ[batchHead]
                batchQ[batchHead] = nil
                batchHead = batchHead + 1
                pcall(fn)
            end
            if batchHead > batchTail then
                task.wait(0.05)
                if batchHead > batchTail then
                    batchQ, batchHead, batchTail = {}, 1, 0
                    batchBusy = false
                    return
                end
            else
                task.wait()
            end
        end
        batchBusy = false
    end)
end

-- ==== FPS BOOST: душилка эффектов (частицы, трейлы, тени от ламп) ====
-- Старый буст менял только тени/качество (часто молча не применялось),
-- поэтому его "не было видно". Этот идёт по инстансам и считает результат.
local fpsFX = {conn = nil, stored = {}, applied = false}
local function fpsSweepFX()
    local n = 0
    -- FIX утечки: чистим мёртвые записи (комнаты выгрузились, инстансы снесены).
    local alive, na = {}, 0
    for _, rec in ipairs(fpsFX.stored) do
        if rec.i and rec.i.Parent then
            na = na + 1
            alive[na] = rec
        end
    end
    fpsFX.stored = alive
    -- Не создаём гигантский GetDescendants-массив: он сам по себе давал пик памяти.
    local stack, processed = {workspace}, 0
    while #stack > 0 and HubActive and fpsBoost do
        local node = table.remove(stack)
        local ok, children = pcall(function() return node:GetChildren() end)
        if ok then
            for _, d in ipairs(children) do
                stack[#stack + 1] = d
                pcall(function()
                    if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Beam") then
                        if d.Enabled then fpsFX.stored[#fpsFX.stored + 1] = {i = d, k = "e"} d.Enabled = false n = n + 1 end
                    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        if d.Shadows then fpsFX.stored[#fpsFX.stored + 1] = {i = d, k = "s"} d.Shadows = false n = n + 1 end
                    end
                end)
                processed = processed + 1
                if processed % PERF.indexYieldEvery == 0 then task.wait() end
            end
        end
    end
    return n
end
local function fpsRestoreFX()
    for _, rec in ipairs(fpsFX.stored) do
        pcall(function()
            local inst = rec.i
            if inst and inst.Parent then
                if rec.k == "e" then inst.Enabled = true else inst.Shadows = true end
            end
        end)
    end
    fpsFX.stored = {}
    if fpsFX.conn then pcall(function() fpsFX.conn:Disconnect() end) fpsFX.conn = nil end
end
local function applyFpsBoost(on, silent)
    fpsBoost = on
    if fpsFX.applied == on then return end
    fpsFX.applied = on
