    local function vipAdd(model)
        if not model or not model:IsA("Model") or not model.Parent then return end
        local kind = vipKindOf(string.lower(model.Name))
        if not kind then return end
        if kind == "figure" then
            if not (tracker.figure or autoFigureESP) then return end
        elseif kind == "mouse" then
            -- мышь-торговец это модель С Humanoid; лампочки/предметы/инструменты не считаем
            if not tracker.mouse or not model:FindFirstChildOfClass("Humanoid") then return end
        elseif not tracker[kind] then
            return
        end
        -- уже размечено и живо — не трогаем; если было очищено — разрешаем повторно
        local isFirst = vipSeen[model] == nil
        if vipSeen[model] and (model:FindFirstChild("M4_ESP_" .. kind, true) or model:FindFirstChild("M4_HL_" .. kind)) then return end
        vipSeen[model] = nil
        do
            local p = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            if p and p.Parent then
                local text = vipTexts[kind]
                if kind == "figure" or kind == "gloombats" then
                    -- ТОЛЬКО эти два без имени: Figure и Gloombats (как просил)
                    ManageHighlight(model, p, kind)
                else
                    ManageESP(model, p, text, kind, true)
                end
                if kind == "figure" and isFirst then
                    pcall(function()
                        Rayfield:Notify({Title = "Figure", Content = "Figure detected — stay quiet!", Duration = 3})
                    end)
                end
                -- авто-очистка: модель Destroying -> удаляем её ESP и запись (без утечек при долгой игре)
                pcall(function()
                    if not model:FindFirstChild("M4_cl") then
                        local tag = Instance.new("BoolValue")
                        tag.Name = "M4_cl"
                        tag.Parent = model
                        model.Destroying:Connect(function()
                            if not HubActive then return end
                            vipSeen[model] = nil
                            removeESPsForModel(model)
                        end)
                    end
                end)
                vipSeen[model] = true
                vipRetry[model] = nil
                return
            end
        end
        -- Частей пока нет (модель собирается стримингом): перепроверим позже
        -- через очередь, БЕЗ task.wait — слип внутри помпы стагнировал её
        -- на 0.45с за модель и очередь взрывалась посреди погони Сика.
        local tries = vipRetry[model] or 0
        if tries < 3 and model.Parent then
            vipRetry[model] = tries + 1
            task.delay(0.3, function()
                if HubActive and model.Parent then batchEnqueue(function() vipAdd(model) end) end
            end)
        else
            vipRetry[model] = nil
        end
    end

    local function vipSweep()
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Model") then vipAdd(v) end
        end
        local ent = workspace:FindFirstChild("Entities") or workspace:FindFirstChild("Monsters") or workspace:FindFirstChild("Entity") or workspace:FindFirstChild("ActiveEntities")
        if ent then
            for _, v in pairs(ent:GetChildren()) do
                if v:IsA("Model") then vipAdd(v) end
            end
        end
        if workspace:FindFirstChild("CurrentRooms") then
            local curR = getCurrentRoom()
            local farBudget = globalEntitySearch and 15000 or 0
            for _, r in ipairs(workspace.CurrentRooms:GetChildren()) do
                if r:IsA("Model") then
                    local rn = tonumber(r.Name)
                    local near = rn and math.abs(rn - curR) <= 2
                    if near then
                        -- рядом: заходим глубже (модели любой вложенности), с бюджетом на тик
                        local stack, budget, processed = {r}, 3000, 0
                        while #stack > 0 and budget > 0 do
                            budget = budget - 1
                            processed = processed + 1
                            local node = table.remove(stack)
                            if node:IsA("Model") then vipAdd(node) end
                            for _, c in ipairs(node:GetChildren()) do
                                if c:IsA("Model") then stack[#stack + 1] = c end
                            end
                            if processed % PERF.indexYieldEvery == 0 then task.wait() end
                        end
                    elseif globalEntitySearch and farBudget > 0 then
                        -- ГЛОБАЛЬНЫЙ ПОИСК: заходим глубже даже в дальние комнаты (общий бюджет на проход)
                        local stack, budget, processed = {r}, math.min(1200, farBudget), 0
                        while #stack > 0 and budget > 0 do
                            budget = budget - 1
                            farBudget = farBudget - 1
                            processed = processed + 1
                            local node = table.remove(stack)
                            if node:IsA("Model") then vipAdd(node) end
                            for _, c in ipairs(node:GetChildren()) do
                                if c:IsA("Model") then stack[#stack + 1] = c end
                            end
                            if processed % PERF.indexYieldEvery == 0 then task.wait() end
                        end
                    else
                        for _, v in ipairs(r:GetChildren()) do
                            if v:IsA("Model") then vipAdd(v) end
                        end
                    end
                end
            end
        end
        for m in pairs(vipSeen) do
            if not m.Parent then vipSeen[m] = nil end
        end
    end

