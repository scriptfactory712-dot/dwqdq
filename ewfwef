                        if (tracker.rush or mv) and ln:find("rush") then ManageESP(v, p, "RUSH — HIDE!", "rush"); dedicated = true end
                        if (tracker.ambush or mv) and ln:find("ambush") then ManageESP(v, p, "AMBUSH — HIDE!", "ambush"); dedicated = true end
                        if (tracker.seek or mv) and ln:find("seek") then ManageHighlight(v, p, "seek"); dedicated = true end
                        if (tracker.eyes or mv) and ln:find("eyes") then ManageESP(v, p, "EYES - НЕ СМОТРИ", "eyes"); dedicated = true end
                        if (tracker.halt or mv) and ln:find("halt") then ManageESP(v, p, "HALT - СТОЙ", "halt"); dedicated = true end
                        if (tracker.screech or mv) and ln:find("screech") then ManageESP(v, p, "SCREECH - СМОТРИ", "screech"); dedicated = true end
                        if (tracker.jack or mv) and ln:find("jack") then ManageESP(v, p, "JACK - НЕ ВХОДИ", "jack"); dedicated = true end
                        local archiveName = ln:gsub("[^%w]", "")
                        if (tracker.teller or mv) and archiveName:find("teller", 1, true) then ManageESP(v, p, "TELLER", "teller", true); dedicated = true end
                        local honchoActor = archiveName:match("^honcho%d*$") or archiveName:match("^elhoncho%d*$")
                            or archiveName:match("^honchoentity%d*$") or archiveName:match("^honchomoving%d*$")
                        if (tracker.honcho or mv) and honchoActor then ManageESP(v, p, "HONCHO", "honcho", true); dedicated = true end
                        if (tracker.bash or mv) and (archiveName:match("^bash%d*$") or archiveName:match("^a60moving%d*$") or archiveName == "a60") then ManageESP(v, p, "BASH — HIDE!", "bash", true); dedicated = true end
                        if (tracker.ransom or mv) and (archiveName:find("ransom", 1, true) or archiveName:match("^a90%d*$")) then ManageESP(v, p, "RANSOM — DON'T MOVE", "ransom", true); dedicated = true end
                        if (tracker.scribbles or mv) and (archiveName:find("scribbl", 1, true) or archiveName:match("^a120moving%d*$") or archiveName == "a120") then ManageESP(v, p, "SCRIBBLES — HIDE!", "scribbles", true); dedicated = true end
                        if (tracker.portrait or mv) and (archiveName == "portrait" or archiveName:find("portraitentity", 1, true) or archiveName:find("mirrorman", 1, true)) then ManageESP(v, p, "PORTRAIT", "portrait", true); dedicated = true end
                        if (tracker.alma or mv) and archiveName:find("alma", 1, true) then ManageESP(v, p, "ALMA", "alma", true); dedicated = true end
                        if (tracker.fih or mv) and (archiveName == "fih" or archiveName:find("fihentity", 1, true) or archiveName == "archivefih") then ManageESP(v, p, "FIH", "fih", true); dedicated = true end
                        if (tracker.blitz or mv) and (ln:find("blitz") or ln:find("backdoorrush")) then ManageESP(v, p, "BLITZ — HIDE!", "blitz"); dedicated = true end
                        if (tracker.lookman or mv) and ln:find("lookman") then ManageESP(v, p, "LOOKMAN — НЕ СМОТРИ", "lookman"); dedicated = true end
                        if (tracker.hide or mv) and ln:find("hide") then ManageESP(v, p, "HIDE — ВЫТОЛКНЕТ", "hide"); dedicated = true end
                        if (tracker.glitch or mv) and ln:find("glitch") then ManageESP(v, p, "GLITCH", "glitch"); dedicated = true end
                        if (tracker.goblino or mv) and ln:find("goblino") then ManageESP(v, p, "EL GOBLINO", "goblino"); dedicated = true end
                        if (tracker.starlight or mv) and (ln:find("starlight") or ln:find("guiding")) then ManageESP(v, p, "STARLIGHT (помощь)", "starlight"); dedicated = true end
                        if (tracker.bramble or mv) and ln:find("bramble") then ManageESP(v, p, "BRAMBLE — CUT", "bramble"); dedicated = true end
                        if (tracker.bob or mv) and ln:find("bob") then ManageESP(v, p, "BOB (мирный)", "bob"); dedicated = true end
                        if (tracker.dread or mv) and ln:find("dread") then ManageESP(v, p, "DREAD", "dread"); dedicated = true end
                        if (tracker.dupe or mv) and ln:find("dupe") then ManageESP(v, p, "DUPE — проверь номер", "dupe"); dedicated = true end
                        if (tracker.louie or mv) and ln:find("louie") then ManageESP(v, p, "LOUIE (дай золото)", "louie"); dedicated = true end
                        if (tracker.void or mv) and ln:find("void") then ManageESP(v, p, "VOID", "void"); dedicated = true end
                        if (tracker.shadow or mv) and ln:find("shadow") then ManageESP(v, p, "SHADOW", "shadow"); dedicated = true end
                        if tracker.drone and ln:find("drone") then
                            dedicated = true
                            local last = droneLastPos[v]
                            local moving = false
                            if last then moving = (p.Position - last).Magnitude > 3 end
                            droneLastPos[v] = p.Position
                            if moving then
                                stampedeUntil = os.clock() + 8
                                lastThreatAt = os.clock()
                                if os.clock() - lastStampedeNotify >= 20 then
                                    lastStampedeNotify = os.clock()
                                    pcall(function()
                                        Rayfield:Notify({Title = "🚨 STAMPEDE", Content = "Дроны бегут — СПРЯЧЬСЯ!", Duration = 4})
                                    end)
                                end
                                if p:FindFirstChild("M4_ESP_drone") then RemoveESPEntry(p, "drone") end
                                ManageESP(v, p, "DRONE STAMPEDE - HIDE!", "droneRun")
                            else
                                if p:FindFirstChild("M4_ESP_droneRun") then RemoveESPEntry(p, "droneRun") end
                                ManageESP(v, p, "Drone - idle", "drone")
                            end
                        end
                        if tracker.monsters and not dedicated and not v:FindFirstChildOfClass("Humanoid") and isMonster(v.Name) then
                            ManageESP(v, p, v.Name, "monster")
                            if not monsterNotified[v] then
                                monsterNotified[v] = true
                                pcall(function()
                                    Rayfield:Notify({Title = "Monster Alert", Content = v.Name .. " detected!", Duration = 1.5})
                                end)
                            end
                        end
                    end
                end)
                for m in pairs(monsterNotified) do
                    if not m.Parent then monsterNotified[m] = nil end
                end
                for m in pairs(droneLastPos) do
                    if not m.Parent then droneLastPos[m] = nil end
                end
                if pruneMonsterTick >= 3 then
                    pruneMonsterTick = 0
                    PruneFarMulti(pruneMonsterDists)
                end
            end)

            pcall(function()
                if not tracker.players then return end
                for _, p in pairs(game.Players:GetPlayers()) do
                    if p ~= LPlayer and p.Character then
                        ManageESP(p.Character, p.Character.PrimaryPart, p.Name, "player")
                    end
                end
                PruneFar("player", 300)
            end)
        end
    end)

