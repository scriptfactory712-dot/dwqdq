    -- ===================== ГЛОБАЛЬНЫЙ ИНДЕКС ПРОМПТОВ =====================
    -- Все ProximityPrompt в workspace, включая те, что лежат ВНЕ CurrentRooms
    -- (мебель в служебных папках, префабы, лобби). Раньше скан шёл только по комнатам,
    -- поэтому объекты вроде «Office Desk with a Dresser» могли не находиться вообще.
    local globalPrompts = setmetatable({}, {__mode = "k"})
    local globalIndexReady = false
    local function indexPromptsIn(root)
        local found = 0
        if not root then return found end
        pcall(function()
            -- GetDescendants создаёт один огромный массив и даёт пик памяти при
            -- открытии/старте. Инкрементальный DFS держит только небольшой стек.
            local stack, processed = {root}, 0
            while #stack > 0 and HubActive do
                local node = table.remove(stack)
                for _, d in ipairs(node:GetChildren()) do
                    if d:IsA("ProximityPrompt") and d.Parent then
                        globalPrompts[d] = true
                        found = found + 1
                    end
                    stack[#stack + 1] = d
                    processed = processed + 1
                    if processed % PERF.indexYieldEvery == 0 then task.wait() end
                end
            end
        end)
        return found
    end
