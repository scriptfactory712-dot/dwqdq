                elseif odDoorLastRoom <= 0 and currentRoom > 0 then
                    -- GameData только появился: это инициализация, а не пройденная дверь.
                    odDoorLastRoom = currentRoom
                    odActiveDoorModel = nil
                    odActiveDoorPart = nil
                    odDoorArmed = false
                    ClearESPType("odDoor")
                elseif currentRoom > odDoorLastRoom then
                    -- Счётчик меняется только после серверного продвижения LatestRoom
                    -- и только если игрок действительно приблизился к активной двери.
                    if odActiveDoorModel and odDoorArmed then
                        odPassedDoors[odActiveDoorModel] = true
                        odDoorCounter = odDoorCounter + 1
                    end
                    odDoorLastRoom = currentRoom
                    odActiveDoorModel = nil
                    odActiveDoorPart = nil
                    odDoorArmed = false
                    ClearESPType("odDoor")
                elseif currentRoom < odDoorLastRoom then
                    -- Новый забег/смена сабфлора.
                    odDoorCounter = 1
                    odDoorLastRoom = currentRoom
                    odActiveDoorModel = nil
                    odActiveDoorPart = nil
                    odDoorArmed = false
                    odPassedDoors = setmetatable({}, {__mode = "k"})
