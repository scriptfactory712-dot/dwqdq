    depth = true, sally = true, wren = true,
    odGroundskeeper = true, odMonument = true, odEyestalk = true, odSurge = true,
    odMandrake = true, odBramble = true, odCaws = true, odGrampy = true, odCrow = true,
    odDoor = true, odGardenCabinet = true, odGate = true, odOuthouse = true, odHiding = true,
    odLever = true, odInfectedLight = true,
    anchorTarget = true, panelTarget = true,
    seekDoor = true,
    haste = true, bdLever = true, bdVacuum = true, bdStarlight = true, curiousLight = true,
    teller = true, honcho = true, bash = true, ransom = true, scribbles = true,
    alma = true, fih = true, portrait = true,
    swCreak = true, swNoise = true, swMeld = true, swStem = true,
    swCobbler = true, swHijack = true, swTerminal = true,
    swFireAlarm = true, swFireEscape = true, swDepot = true,
