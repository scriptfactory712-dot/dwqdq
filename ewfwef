    task.spawn(function()
        while HubActive do
            task.wait(fpsBoost and 1 or 0.5)
            pcall(function()
                local inBackdoor = getFloor() == 0
                local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not inBackdoor or not root then
                    if bdWasInBackdoor then
                        ClearESPType("bdLever")
                        ClearESPType("bdVacuum")
                        ClearESPType("bdStarlight")
                        ClearESPType("haste")
                        ClearESPType("curiousLight")
                        bdClearEntity("blitz", "blitz")
                        bdClearEntity("lookman", "lookman")
                        bdClearEntity("glitch", "glitch")
                        if not tracker.keys then ClearESPType("key") end
                        if not tracker.gold then ClearESPType("gold") end
                        if not tracker.hiding then ClearESPType("hiding") end
                    end
                    bdWasInBackdoor = false
                    BackdoorRoomLabel.Visible = false
                    BackdoorThreatLabel.Visible = false
                    return
                end
                bdWasInBackdoor = true

                -- FIX: если ни одна Backdoor-фича не включена — дальше не идём.
                -- Раньше тик разбирал комнаты каждые 0.5с даже с выключенными тумблерами.
                local bdAny = bdRuntime.autoHide or bdRuntime.fullbright
                if not bdAny then
                    for _, on in pairs(bdEnabled) do
                        if on then bdAny = true break end
                    end
                end
                if not bdAny then return end

                local currentRoom = getCurrentRoom()
                local now = os.clock()

                local rooms = getNearbyRooms()
                if #rooms == 0 and workspace:FindFirstChild("CurrentRooms") then
                    rooms = workspace.CurrentRooms:GetChildren()
                end
                local threatLines = {}
                local vacuumChecked = {}
                local entityChecked = {}

                local function processBackdoorEntity(model)
                    if entityChecked[model] then return end
                    entityChecked[model] = true
                    local kind, label = bdEntityKind(model)
                    local part = bdCachedPart(model)
                    if not kind or not part then return end
                    local dist = (part.Position - root.Position).Magnitude
                    if bdEnabled[kind] then
                        local typeKey = kind == "curiousLight" and "curiousLight" or kind
                        ManageESP(model, part, label, typeKey, true)
                    end
                    if bdEnabled.threatSystem and dist <= 1000 then
                        local message = kind == "curiousLight" and "CURIOUS LIGHT — SAFE / EXIT" or label
                        threatLines[#threatLines + 1] = message .. " " .. arrowTo(part.Position) .. " " .. math.floor(dist) .. "m"
                        if kind ~= "curiousLight" and not bdThreatNotified[model] then
                            bdThreatNotified[model] = true
                            Rayfield:Notify({Title = "⚠ BACKDOOR THREAT", Content = message, Duration = 4})
                        end
                    end
                end

                for _, room in ipairs(rooms) do
                    for _, model in ipairs(bdRoomModels(room)) do
                        do
                            local part = bdCachedPart(model)
                            if part then
                                processBackdoorEntity(model)
                                if bdIsTimerLever(model) then
                                    local prompt = bdPromptCache[model]
                                    if prompt and not prompt.Parent then
                                        prompt = nil
                                        bdPromptCache[model] = nil
                                    end
                                    if prompt == nil then
                                        prompt = bdLeverPrompt(model)
                                        if prompt then bdPromptCache[model] = prompt end
                                    end
                                    local available = bdLeverIsAvailable(model, prompt)
                                    local bonus = bdBonusCache[model]
                                    if bonus == nil then
                                        bonus = bdLeverBonus(model) or false
                                        bdBonusCache[model] = bonus
                                    end
                                    if bonus == false then bonus = nil end
                                    if available and bdEnabled.lever then
                                        local suffix = bonus and (" [+" .. tostring(bonus) .. "s]") or ""
                                        ManageESP(model, part, "TIMER LEVER" .. suffix, "bdLever", true)
                                    elseif not available then
                                        RemoveESPEntry(part, "bdLever")
                                    end
                                    if available and bdEnabled.autoLever and prompt and (part.Position - root.Position).Magnitude <= bdAutoRadius then
                                        local last = bdLeverTriggeredAt[model] or 0
                                        if now - last >= 1.5 then
                                            bdLeverTriggeredAt[model] = now
                                            FirePrompt(prompt)
                                        end
                                    end
                                end

                                if bdEnabled.vial and bdIsStarlightVial(model) then ManageHighlight(model, part, "bdStarlight") end
                                if bdEnabled.key and bdIsRoomKey(model) then ManageHighlight(model, part, "key") end
                                if bdEnabled.gold and bdIsGold(model) then ManageHighlight(model, part, "gold") end
                                if bdEnabled.hiding and bdIsHiding(model) then ManageHighlight(model, part, "hiding") end

                                if not vacuumChecked[model] and bdCachedVacuum(model) then
                                    vacuumChecked[model] = true
                                    local dist = (part.Position - root.Position).Magnitude
                                    if bdEnabled.vacuum then ManageESP(model, part, "VACUUM — DO NOT ENTER", "bdVacuum", true) end
                                    if bdEnabled.threatSystem and dist <= 300 then
                                        threatLines[#threatLines + 1] = "VACUUM — DON'T OPEN " .. arrowTo(part.Position) .. " " .. math.floor(dist) .. "m"
                                        if not bdThreatNotified[model] then
                                            bdThreatNotified[model] = true
                                            Rayfield:Notify({Title = "⚠ VACUUM", Content = "Dangerous side door nearby — do not enter.", Duration = 4})
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if bdEnabled.autoDoor then
                        for _, prompt in ipairs(getRoomPrompts(room)) do
                            local promptPos = prompt.Parent and promptWorldPosition(prompt) or nil
                            if promptPos and mainRoomDoorForPrompt(prompt)
                                and (promptPos - root.Position).Magnitude <= bdAutoRadius then
                                FirePrompt(prompt)
                            end
                        end
                    end
                end

                forEachEntityModel(processBackdoorEntity)

                if bdEnabled.roomType then
                    local currentRooms = workspace:FindFirstChild("CurrentRooms")
                    local room = currentRooms and currentRooms:FindFirstChild(tostring(currentRoom))
                    BackdoorRoomLabel.Visible = true
                    BackdoorRoomLabel.Text = bdRoomType(room, currentRoom)
                else
                    BackdoorRoomLabel.Visible = false
                end

                if bdEnabled.threatSystem then
                    while #threatLines > 9 do table.remove(threatLines) end
                    BackdoorThreatLabel.Visible = true
                    BackdoorThreatLabel.Text = #threatLines > 0 and table.concat(threatLines, "\n") or "BACKDOOR: no active threats"
                else
                    BackdoorThreatLabel.Visible = false
                end

                PruneFar("bdLever", 500)
                PruneFar("bdVacuum", 500)
                PruneFar("bdStarlight", 400)
            end)
        end
    end)

