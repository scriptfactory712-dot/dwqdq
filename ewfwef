local function fetch(url)
    local src = nil
    -- 1) штатный HttpGet
    pcall(function() src = game:HttpGet(url) end)
    -- 2) request-функции экзекьюторов (syn / fluxus / http)
    if type(src) ~= "string" or #src < 200 then
        pcall(function()
            local fn = (syn and syn.request) or (fluxus and fluxus.request)
                or request or http_request or (http and http.request)
            if fn then
                local res = fn({Url = url, Method = "GET"})
                if type(res) == "string" then
                    src = res
                elseif res and type(res.Body) == "string" then
                    src = res.Body
                end
            end
        end)
    end
    return src
end

local function makeNoopStub()
    local t
    t = setmetatable({}, {
        __index = function(tbl, k)
            local fn = function() return t end
            rawset(tbl, k, fn)
            return fn
        end
    })
    return t
end

local function loadLib(url)
    local src = fetch(url)
    if type(src) == "string" and #src > 200 and not src:match("^%s*<") then
        local ok, lib = pcall(function() return loadstring(src)() end)
        if ok and type(lib) == "table" then return lib end
    end
    return nil
end

