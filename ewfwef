        pcall(function()
            if type(gethui) == "function" then h = gethui() end
        end)
        if type(h) == "userdata" or type(h) == "table" then
            g.Parent = h
            placed = true
        end
    end)
    if not placed then
        pcall(function() g.Parent = game:GetService("CoreGui") placed = true end)
    end
    if (not placed) or (not g.Parent) then
        pcall(function()
            if LPlayer then
                local pg = LPlayer:FindFirstChildOfClass("PlayerGui") or LPlayer:FindFirstChild("PlayerGui")
                if not pg then pg = LPlayer:WaitForChild("PlayerGui", 5) end
                if pg then g.Parent = pg end
            end
        end)
    end
end

