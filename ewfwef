    -- Keep the anti scanner in its own closure so StartHub stays below Luau's
    -- 200-local-register limit.
    do
    (function()
        local enabled = antiRuntime.enabled
        local screechRemote = nil
        local screechRemoteAt = 0
        -- FIX лагов: если remote нет — не обходим весь ReplicatedStorage
        -- на каждый чих, а пересматриваем не чаще раза в 5с.
        local function getScreechRemote()
            if screechRemote and screechRemote.Parent then return screechRemote end
            if os.clock() - screechRemoteAt < 5 then return screechRemote end
            screechRemoteAt = os.clock()
            screechRemote = nil
            pcall(function()
                for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") and string.lower(remote.Name) == "screech" then
                        screechRemote = remote
                        break
                    end
                end
            end)
            return screechRemote
        end
        local function normalizedName(instance)
            return string.lower(tostring(instance and instance.Name or "")):gsub("[^%w]", "")
        end
        local function runningDroneContext(instance)
            local current = instance
            for _ = 1, 10 do
                if not current then break end
                local n = normalizedName(current)
                if n:find("stampede", 1, true) or n:find("droneswarm", 1, true)
                    or n:find("dronerun", 1, true) or n:find("dronemoving", 1, true)
                    or n:find("runningdrone", 1, true) then
                    return true
                end
                current = current.Parent
            end
            return false
        end
        local function antiKind(instance)
            if not instance then return nil end
            local n = normalizedName(instance)
            if n:find("drone", 1, true) and not runningDroneContext(instance) then return "drone" end
            if n:find("screech", 1, true) then return "screech" end
            if n:find("timothy", 1, true) or n == "spider" or n:find("spiderjumpscare", 1, true) then return "timothy" end
            return nil
        end
        local function destroyBlocked(target, kind)
            if not target or not target.Parent then return end
            if kind == "drone" and target:IsA("Model") and not target:FindFirstChild("Root", true) then
                task.delay(0.35, function()
                    if HubActive and enabled.drone and target.Parent and not runningDroneContext(target) then
                        removeESPsForModel(target)
                        pcall(function() target:Destroy() end)
                    end
                end)
                return
            end
            removeESPsForModel(target)
            pcall(function() target:Destroy() end)
        end
        local function removeBlocked(instance)
            local directKind = antiKind(instance)
            local current = instance and (instance:IsA("Model") and instance or instance.Parent)
            for _ = 1, 7 do
                if not current then break end
                if current:IsA("Model") then
                    local kind = antiKind(current)
                    if kind and enabled[kind] then
                        if kind == "screech" then
                            local sr = getScreechRemote()
                            if sr then pcall(function() sr:FireServer(true) end) end
                        end
                        destroyBlocked(current, kind)
                        return
                    end
                end
                current = current.Parent
            end
            if directKind and enabled[directKind] and instance and instance.Parent then
                if directKind == "screech" then
                    local sr = getScreechRemote()
                    if sr then pcall(function() sr:FireServer(true) end) end
                end
                destroyBlocked(instance, directKind)
            end
        end
        local function scanAll()
            if not HubActive then return end
            for _, instance in ipairs(workspace:GetDescendants()) do
                removeBlocked(instance)
            end
            for _, instance in ipairs(Camera:GetDescendants()) do
                removeBlocked(instance)
            end
        end

        local AntiTab = trackTab(Window:CreateTab("Anti", 4483362458))
        AntiTab:CreateSection("Remove entities before they can act")
        AntiTab:CreateToggle({Name = "Anti Idle Drone (standing only)", CurrentValue = false, Callback = function(v)
            enabled.drone = v
            if v then task.defer(scanAll) end
        end})
        AntiTab:CreateToggle({Name = "Anti Screech", CurrentValue = false, Callback = function(v)
            enabled.screech = v
            if v then task.defer(scanAll) end
        end})
        AntiTab:CreateToggle({Name = "Anti Timothy", CurrentValue = false, Callback = function(v)
            enabled.timothy = v
            if v then task.defer(scanAll) end
        end})

        workspace.DescendantAdded:Connect(function(instance)
            if not HubActive then return end
            if enabled.drone or enabled.screech or enabled.timothy then
                batchEnqueue(function() removeBlocked(instance) end)
            end
        end)
        Camera.DescendantAdded:Connect(function(instance)
            if not HubActive then return end
            if enabled.drone or enabled.screech or enabled.timothy then
                batchEnqueue(function() removeBlocked(instance) end)
            end
        end)
        antiRuntime.disable = function()
            enabled.drone = false
            enabled.screech = false
            enabled.timothy = false
        end
    end)()
    end

    local function scanLobby()
        pcall(function()
            for _, m in ipairs(workspace:GetChildren()) do
                if m:IsA("Model") and string.lower(m.Name):find("lobby") then
                    for _, v in ipairs(m:GetDescendants()) do
                        if v:IsA("Model") then
                            local ln = string.lower(v.Name)
                            local p = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                            if p then
                                if ln:find("jeff") or ln:find("shop") then ManageESP(v, p, "Jeff Shop", "jeff") end
                                if ln:find("elevator") then ManageESP(v, p, "Elevator", "elevator") end
                                if ln:find("vending") or ln:find("dispenser") then ManageESP(v, p, "Vending", "shakelightMachine") end
                            end
                        end
                    end
                end
            end
        end)
    end

