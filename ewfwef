                local onFloor = getFloor() == 5
                if onFloor and (S.scanNeeded or not S.wasOnFloor) then
                    S.scanNeeded = false
                    scanExisting()
                elseif not onFloor and S.wasOnFloor then
                    clearAll()
                    ThreatLabel.Visible = false
                    ThreatLabel.Text = ""
                end
                S.wasOnFloor = onFloor
                if onFloor and S.threat then
                    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local lines = {}
                    for object, record in pairs(S.entities) do
                        if object.Parent and record.part and record.part.Parent then
                            local distance = root and (record.part.Position - root.Position).Magnitude or math.huge
                            if distance <= 1200 then
                                lines[#lines + 1] = {distance = distance, text = record.config.advice .. " " .. arrowTo(record.part.Position) .. " " .. math.floor(distance) .. "m"}
                                if not S.notified[object] then
                                    S.notified[object] = true
                                    Rayfield:Notify({Title = "⚠ STAIRWELL", Content = record.config.advice, Duration = 4})
                                end
                            end
                        end
                    end
                    table.sort(lines, function(a, b) return a.distance < b.distance end)
                    while #lines > 7 do table.remove(lines) end
                    local textLines = {}
                    for _, line in ipairs(lines) do textLines[#textLines + 1] = line.text end
                    ThreatLabel.Visible = true
                    ThreatLabel.Text = #textLines > 0 and table.concat(textLines, "\n") or "STAIRWELL: no active threats"
                elseif not S.threat then
                    ThreatLabel.Visible = false
                end
            end
        end)

