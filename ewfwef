                return
            end
        end
    end
    local function isFuseInsertPrompt(prompt)
        local action = ""
        pcall(function() action = string.lower((prompt.ActionText or "") .. " " .. (prompt.ObjectText or "")) end)
        local actionMatches = action:find("insert") or action:find("place") or action:find("install") or action:find("repair")
        local actionTarget = action:find("fuse") or action:find("bulb") or action:find("generator")
        local anc = prompt.Parent
        for _ = 1, 4 do
            if not anc then break end
            local ln = string.lower(anc.Name)
            if ln:find("generator") or ln:find("fuseslot") or ln:find("fuseholder") or ln:find("fusebox") then
                return true
            end
            anc = anc.Parent
        end
        return actionMatches ~= nil and actionTarget ~= nil
    end
