local function GlobalPruneFar()
    if not LPlayer.Character or not LPlayer.Character.PrimaryPart then return end
    local pos = LPlayer.Character.PrimaryPart.Position
    for i = #ActiveESPs, 1, -1 do
        local esp = ActiveESPs[i]
        -- стейл-записи (модель/парт уничтожены) — всегда чистим
        if not esp.Model or not esp.Model.Parent or not esp.Part or not esp.Part.Parent then
            if esp.Billboard then esp.Billboard:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            clearModelTags(esp.Model, esp.Type)
            table.remove(ActiveESPs, i)
        elseif not PRIORITY_ESP[esp.Type] and (esp.Part.Position - pos).Magnitude > MAX_ESP_DISTANCE then
            if esp.Billboard then esp.Billboard:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            clearModelTags(esp.Model, esp.Type)
            table.remove(ActiveESPs, i)
        end
    end
    if #ActiveESPs > MAX_ESPS then
        -- сортируем: приоритетные первые, потом по ВОЗРАСТАНИЮ дистанции.
        -- Хвост = самые дальние неприоритетные -> их и выкидываем.
        table.sort(ActiveESPs, function(a, b)
            local ea, eb = PRIORITY_ESP[a.Type], PRIORITY_ESP[b.Type]
            if ea and not eb then return true end
            if eb and not ea then return false end
            local da = a.Part and (a.Part.Position - pos).Magnitude or math.huge
            local db = b.Part and (b.Part.Position - pos).Magnitude or math.huge
            return da < db
        end)
        for i = #ActiveESPs, MAX_ESPS + 1, -1 do
            local esp = ActiveESPs[i]
            if not PRIORITY_ESP[esp.Type] then
                if esp.Billboard then esp.Billboard:Destroy() end
                if esp.Highlight then esp.Highlight:Destroy() end
                clearModelTags(esp.Model, esp.Type)
                table.remove(ActiveESPs, i)
            end
        end
    end
end

local function ManageESP(model, part, text, colorType, big, replaceType)
    if not part or not model then return end

    -- Некоторые режимы являются более важной версией обычной метки того же объекта
    -- (например, текущий anchorTarget вместо общей метки anchor).
    if replaceType then
        for i = #ActiveESPs, 1, -1 do
            local old = ActiveESPs[i]
            if old.Model == model and old.Type == replaceType then
                if old.Billboard then old.Billboard:Destroy() end
                if old.Highlight then old.Highlight:Destroy() end
                clearModelTags(old.Model, old.Type)
                table.remove(ActiveESPs, i)
            end
        end
    end

    -- Повторный вызов для той же модели и того же типа обновляет существующую запись.
    -- Это не даёт периодическим сканерам создавать дубликаты.
    for _, existing in ipairs(ActiveESPs) do
        if existing.Model == model and existing.Type == colorType and existing.Part and existing.Part.Parent then
            existing.Text = text
            if existing.Label then existing.Label.Text = text end
            if existing.Billboard then
                existing.Billboard.Size = big and UDim2.new(0, 260, 0, 80) or UDim2.new(0, 160, 0, 28)
            end
            return existing
        end
    end

    -- дедупликация: если на детали уже есть ЛЮБАЯ наша метка — не вешаем вторую поверх
    for _, c in ipairs(part:GetChildren()) do
        if c:IsA("BillboardGui") and string.find(c.Name, "M4_ESP_", 1, true) then
            return
        end
    end
    -- ОДНА надпись на объект: если у модели уже есть наша метка на любой части — не дублируем
    -- (чтобы вместо кучи "Door ..." была одна надпись на дверь)
    if model ~= part then
        local checked = 0
        for _, d in ipairs(model:GetDescendants()) do
            checked = checked + 1
            if checked > 200 then break end
            if d:IsA("BillboardGui") and string.find(d.Name, "M4_ESP_", 1, true) then
                return
            end
        end
    end
    if #ActiveESPs >= MAX_ESPS then
        local priorityTypes = PRIORITY_ESP
        local farthestIdx, farthestDist = nil, 0
        local root = LPlayer.Character and LPlayer.Character.PrimaryPart
        if root then
            for i, esp in ipairs(ActiveESPs) do
                if not priorityTypes[esp.Type] and esp.Part then
                    local d = (esp.Part.Position - root.Position).Magnitude
                    if d > farthestDist then farthestDist, farthestIdx = d, i end
                end
            end
            if farthestIdx then
                local esp = ActiveESPs[farthestIdx]
                if esp.Billboard then esp.Billboard:Destroy() end
                if esp.Highlight then esp.Highlight:Destroy() end
                clearModelTags(esp.Model, esp.Type)
                table.remove(ActiveESPs, farthestIdx)
            else
                return
            end
        else
            return
        end
    end
    local hl = Instance.new("Highlight")
    hl.Name = "M4_Highlight_" .. colorType
    hl.FillTransparency = 0.7
    hl.FillColor = espSettings.colors[colorType] or Color3.new(1, 1, 1)
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "M4_ESP_" .. colorType
    billboard.AlwaysOnTop = true
    billboard.Size = big and UDim2.new(0, 260, 0, 80) or UDim2.new(0, 160, 0, 28)
    billboard.ExtentsOffset = Vector3.new(0, 2.0, 0)
    local label = Instance.new("TextLabel", billboard)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = big and 30 or 18
    label.Text = text
    label.TextColor3 = espSettings.colors[colorType] or Color3.new(1, 1, 1)
    billboard.Parent = part
    table.insert(ActiveESPs, {
        Model = model, Part = part, Billboard = billboard, Highlight = hl,
        Text = text, Type = colorType, Label = label
    })
    return nil
end

local function ManageHighlight(model, part, colorType, soft)
    if not part or not model then return end
    -- дедупликация: одна подсветка на модель (любой тип), без наложений
    for _, c in ipairs(model:GetChildren()) do
        if c.Name:find("M4_HL_", 1) and (c:IsA("Highlight") or c:IsA("BoolValue")) then
            return
        end
    end
    if #ActiveESPs >= MAX_ESPS then
        if not PRIORITY_ESP[colorType] then return end
        local root = LPlayer.Character and LPlayer.Character.PrimaryPart
        local farthestIdx, farthestDist = nil, -1
        if root then
            for i, esp in ipairs(ActiveESPs) do
                if not PRIORITY_ESP[esp.Type] and esp.Part and esp.Part.Parent then
                    local dist = (esp.Part.Position - root.Position).Magnitude
                    if dist > farthestDist then farthestIdx, farthestDist = i, dist end
                end
            end
        end
        if not farthestIdx then return end
        local old = ActiveESPs[farthestIdx]
        if old.Billboard then old.Billboard:Destroy() end
        if old.Highlight then old.Highlight:Destroy() end
        clearModelTags(old.Model, old.Type)
        table.remove(ActiveESPs, farthestIdx)
    end
    local hl = Instance.new("Highlight")
    hl.Name = "M4_HL_" .. colorType
    -- soft = только контур (без заливки) — не заливает экран цветом
    hl.FillTransparency = soft and 0.93 or 0.6
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = espSettings.colors[colorType] or Color3.new(1, 1, 1)
    hl.Parent = model
    local tag = Instance.new("BoolValue")
    tag.Name = "M4_HL_" .. colorType
    tag.Parent = model
    table.insert(ActiveESPs, {
        Model = model, Part = part, Billboard = nil, Highlight = hl,
        Text = "", Type = colorType, Label = nil
    })
end

local function isCyanPart(p)
    local c = p.Color
    return (c.B > 0.45 and c.B > c.R + 0.1)
end

local function PruneFar(typeKey, maxDist)
    if not LPlayer.Character or not LPlayer.Character.PrimaryPart then return end
    local pos = LPlayer.Character.PrimaryPart.Position
    for i = #ActiveESPs, 1, -1 do
        local esp = ActiveESPs[i]
        if esp.Type == typeKey and esp.Part and (esp.Part.Position - pos).Magnitude > maxDist then
            if esp.Billboard then esp.Billboard:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            clearModelTags(esp.Model, esp.Type)
            table.remove(ActiveESPs, i)
        end
    end
end

local function PruneFarMulti(distMap)
    if not LPlayer.Character or not LPlayer.Character.PrimaryPart then return end
    local pos = LPlayer.Character.PrimaryPart.Position
    for i = #ActiveESPs, 1, -1 do
        local esp = ActiveESPs[i]
        -- приоритетные типы (Grumble/Queen/якоря/компьютер/Bulklight и т.п.) не режем,
        -- чтобы VIP-ESP не мигало из-за обычных прунов
        local maxDist = distMap[esp.Type]
        if maxDist and esp.Part and not PRIORITY_ESP[esp.Type] and (esp.Part.Position - pos).Magnitude > maxDist then
            if esp.Billboard then esp.Billboard:Destroy() end
            if esp.Highlight then esp.Highlight:Destroy() end
            clearModelTags(esp.Model, esp.Type)
            table.remove(ActiveESPs, i)
        end
    end
end

