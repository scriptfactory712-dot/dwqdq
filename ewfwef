                Size = UDim2.new(1, -32, 0, 8), Position = UDim2.new(0, 16, 0, 46),
                BackgroundColor3 = C.track, BorderSizePixel = 0,
            }, r)
            round(track, 4)
            local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, BorderSizePixel = 0}, track)
            round(fill, 4)
            local knob = new("Frame", {
                Size = UDim2.new(0, 20, 0, 20), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0, ZIndex = 3,
            }, track)
            round(knob, 10)
            local dragging = false
            local function setRel(rel, fire)
                rel = math.clamp(rel, 0, 1)
                local raw = minV + (maxV - minV) * rel
                val = math.clamp(math.floor(raw / inc + 0.5) * inc, minV, maxV)
                fill.Size = UDim2.new(rel, 0, 1, 0)
                knob.Position = UDim2.new(rel, 0, 0.5, 0)
                valLbl.Text = tostring(val) .. suffix
                if fire and cfg and cfg.Callback then
                    task.spawn(function() pcall(cfg.Callback, val) end)
                end
            end
            setRel((val - minV) / math.max(0.0001, (maxV - minV)), false)
            local hit = new("TextButton", {
                Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
                AutoButtonColor = false, ZIndex = 4,
            }, track)
            hit.MouseButton1Down:Connect(function()
                dragging = true
                local mx = UIS:GetMouseLocation().X
                setRel((mx - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), true)
            end)
            UIS.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    setRel((input.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), true)
                end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            return {
                Set = function(_, v)
                    local nv = tonumber(v) or minV
                    setRel((nv - minV) / math.max(0.0001, (maxV - minV)), false)
                end
            }
        end

        function tab:CreateButton(cfg)
            local r = row(52)
            local label = new("TextLabel", {
