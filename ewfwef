                        if d.Enabled then fpsFX.stored[#fpsFX.stored + 1] = {i = d, k = "e"} d.Enabled = false end
                    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
                        if d.Shadows then fpsFX.stored[#fpsFX.stored + 1] = {i = d, k = "s"} d.Shadows = false end
                    end
                end)
            end)
