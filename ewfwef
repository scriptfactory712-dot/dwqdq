    DoorAssist.pickupCache = setmetatable({}, {__mode = "k"})
    function DoorAssist.isItemPickupPrompt(prompt)
        if not prompt or not prompt.Parent or not prompt:IsA("ProximityPrompt") then return false end
        local cached = DoorAssist.pickupCache[prompt]
        if cached ~= nil then return cached end
        if isHidingPrompt(prompt) or DoorAssist.protected(prompt) or isDoorPrompt(prompt)
            or isContainerPrompt(prompt) or IsGoldPrompt(prompt) then
            DoorAssist.pickupCache[prompt] = false
            return false
        end
        local action = string.lower(tostring(prompt.ActionText or ""))
        if action:find("insert", 1, true) or action:find("install", 1, true)
            or action:find("place", 1, true) then
            DoorAssist.pickupCache[prompt] = false
            return false
        end
        local hit = action:find("take", 1, true) or action:find("pick up", 1, true)
            or action:find("pickup", 1, true) or action:find("grab", 1, true)
            or action:find("collect", 1, true) or action:find("obtain", 1, true)
        local cur = prompt.Parent
        for _ = 1, 7 do
            if not cur then break end
            if cur:IsA("Tool") then hit = true break end
            local n = DoorAssist.normal(cur.Name)
            local baseName = n:gsub("%d+$", "")
            if DoorAssist.pickupNames[n] or DoorAssist.pickupNames[baseName]
                or n:find("pickup", 1, true) or n:find("obtain", 1, true) then
                hit = true
                break
            end
            cur = cur.Parent
        end
        DoorAssist.pickupCache[prompt] = hit and true or false
        return DoorAssist.pickupCache[prompt]
    end
