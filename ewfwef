    -- Возвращает комнату-владельца и целевой RoomID двери, если он указан на ней или родителях.
    local function odRoomNumberFor(instance)
        local roomNumber, targetId = nil, nil
        local cur = instance
        for _ = 1, 8 do
            if not cur then break end
            local ok, id = pcall(function() return cur:GetAttribute("RoomID") end)
            if ok and tonumber(id) and not targetId then targetId = tonumber(id) end
            if tonumber(cur.Name) and cur.Parent and cur.Parent.Name == "CurrentRooms" then
                roomNumber = tonumber(cur.Name)
                break
            end
            cur = cur.Parent
        end
        return roomNumber, targetId
    end
