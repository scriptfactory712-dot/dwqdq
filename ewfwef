    -- ============ ANCHOR SYSTEM (AnchorA..AnchorF + терминал MainTerminal/MainControlPanel) ============
    -- Событийная система, БЕЗ тяжёлых сканов по кадрам:
    -- • новая комната (CurrentRooms.ChildAdded) -> сразу ищем в ней якоря (один проход по событию);
    -- • Grumble/Queen слушаем в workspace.Status (ChildAdded, + кэш уже существующих);
    -- • авто-очистка: Destroying модели -> её ESP удаляется (никаких утечек за долгую игру);
    -- • Quest-маркер читает надпись терминала («Anchor A Code» / «Код якоря А» /
    --   «ПОЖАЛУЙСТА, НАЙДИТЕ ЯКОРЬ И ВВЕДИТЕ КОД:») и подсвечивает ТОЛЬКО текущий нужный якорь;
    --   после ввода кода надпись меняется -> маркер сам переходит A→B→C→D→E→F/Z;
    --   когда всё сделано — ведёт к терминалу и красной кнопке.

    local ANCHOR_SEQ = {"A", "B", "C", "D", "E", "F", "Z"}
    local anchorRegistry = {}          -- буква -> {model, part}
    local lastTargetMode = nil
    local lastTargetLetter = nil

    -- транслитерация кириллицы (русские надписи: «Код якоря А»)
    local RU2LAT = {
        ["А"]="A", ["а"]="A", ["Б"]="B", ["б"]="B", ["В"]="V", ["в"]="V",
        ["Г"]="G", ["г"]="G", ["Д"]="D", ["д"]="D", ["Е"]="E", ["е"]="E", ["Ё"]="E", ["ё"]="E",
        ["Ж"]="ZH", ["ж"]="ZH", ["З"]="Z", ["з"]="Z", ["И"]="I", ["и"]="I", ["Й"]="Y", ["й"]="Y",
        ["К"]="K", ["к"]="K", ["Л"]="L", ["л"]="L", ["М"]="M", ["м"]="M", ["Н"]="N", ["н"]="N",
        ["О"]="O", ["о"]="O", ["П"]="P", ["п"]="P", ["Р"]="R", ["р"]="R", ["С"]="S", ["с"]="S",
        ["Т"]="T", ["т"]="T", ["У"]="U", ["у"]="U", ["Ф"]="F", ["ф"]="F", ["Х"]="H", ["х"]="H",
        ["Ц"]="C", ["ц"]="C", ["Ч"]="CH", ["ч"]="CH", ["Ш"]="SH", ["ш"]="SH", ["Щ"]="SH", ["щ"]="SH",
        ["Ъ"]="", ["ъ"]="", ["Ы"]="Y", ["ы"]="Y", ["Ь"]="", ["ь"]="", ["Э"]="E", ["э"]="E",
        ["Ю"]="YU", ["ю"]="YU", ["Я"]="YA", ["я"]="YA",
    }
    local function translit(s)
        local up = tostring(s or "")
        for k, v in pairs(RU2LAT) do
            up = up:gsub(k, v)
        end
        return string.upper(up)
    end

    local ALLOWED_LETTERS = {A = true, B = true, C = true, D = true, E = true, F = true, Z = true}
    local function allowedLetter(ch)
        return ch ~= nil and ALLOWED_LETTERS[ch] == true
    end

    -- буква из текста терминала (транслит + паттерны «ANCHOR A», «ЯКОРЬ/ЯКОРЯ А», «A CODE/КОД», одна буква)
    local function letterFromText(raw)
        local up = translit(raw)
        if up == "" then return nil end
        -- FIX неверной буквы: голые паттерны "X CODE"/"X KOD" цепляли букву
        -- из статического текста ("...ВВЕДИТЕ КОД:" -> E) вместо буквы якоря.
        -- Буква якоря всегда идёт рядом с ANCHOR/ЯКОРЬ (первые 3 паттерна);
        -- одиночные буквы у ключевых слов ловит токен-фолбек ниже.
        local L = up:match("ANCHOR%s+([A-Z])")
            or up:match("YAKORYA%s+([A-Z])")
            or up:match("YAKOR%s+([A-Z])")
        if L and allowedLetter(L) then return L end
        local single = up:match("^%s*([A-Z])%s*$")
        if single and allowedLetter(single) then return single end
        -- одиночная буква-токен рядом с ключевыми словами
        if up:find("ANCHOR") or up:find("YAKORYA") or up:find("YAKOR") or up:find("CODE") or up:find("KOD") then
            for i = 1, #up do
                local ch = up:sub(i, i)
                if ch:match("[A-Z]") then
                    local before = i > 1 and up:sub(i - 1, i - 1) or ""
                    local after = i < #up and up:sub(i + 1, i + 1) or ""
                    if (before == "" or not before:match("%a")) and (after == "" or not after:match("%a")) then
                        if allowedLetter(ch) then return ch end
                    end
                end
            end
        end
        return nil
    end

    -- буква из имени модели: AnchorA..AnchorF (точно), Anchor F, NavAnchor_B — фолбек через текст
    local function letterFromName(name)
        local n = tostring(name or "")
        local head = n:sub(1, 6):lower()
        if head == "anchor" and #n == 7 then
            local ch = n:sub(7, 7):upper()
            -- FIX: без allowedLetter сюда попадал любой AnchorX и вечно
            -- занимал чужой слот (allSolved никогда не наступал).
            if ch:match("[A-Z]") and allowedLetter(ch) then return ch end
        end
        return letterFromText(n)
    end

    -- одиночная буква-токен в строке (дисплей/табличка на самом автомате: "A", "Display A", "Letter_B")
    local function singleLetterToken(s)
        local up = translit(tostring(s or ""))
        for i = 1, #up do
            local ch = up:sub(i, i)
            if ch:match("[A-Z]") then
                local before = i > 1 and up:sub(i - 1, i - 1) or ""
                local after = i < #up and up:sub(i + 1, i + 1) or ""
                if (before == "" or not before:match("%a")) and (after == "" or not after:match("%a")) then
                    return ch
                end
            end
        end
        return nil
    end

    -- является ли модель якорем/автоматом (по имени)
    local function isAnchorModelName(n)
        local ln = string.lower(tostring(n or ""))
        return ln:find("anchor") or ln:find("navanchor") or ln:find("winch") or ln:find("windlass")
    end

    local SOLVED_NAMES = {Solved = true, Completed = true, Done = true, Finished = true, Activated = true, Unlocked = true}
    local SOLVED_ATTRS = {"Solved", "Completed", "Done", "Finished", "Activated", "Unlocked"}
    -- "решён" ли якорь: атрибуты / BoolValue внутри модели (или nil = неизвестно)
    local function isAnchorSolved(model)
        for _, k in ipairs(SOLVED_ATTRS) do
            local ok, a = pcall(function() return model:GetAttribute(k) end)
            if ok and a ~= nil then return a == true end
        end
        local ok, locked = pcall(function() return model:GetAttribute("Locked") end)
        if ok and locked ~= nil then return locked == false end
        for _, c in ipairs(model:GetChildren()) do
            if c:IsA("BoolValue") then
                if c.Name == "Locked" then return c.Value == false end
                if SOLVED_NAMES[c.Name] then return c.Value == true end
            end
        end
        return nil
    end

    -- регистрация найденного якоря + буквенная метка + авто-очистка по Destroying
    local function addAnchorModel(m)
        if not m or not m:IsA("Model") or not m.Parent then return end
        local L = letterFromName(m.Name)
        if not L and isAnchorModelName(m.Name) then
            -- иногда буква только на деталях автомата (дисплей/табличка)
            for _, c in ipairs(m:GetChildren()) do
                local ch = singleLetterToken(c.Name)
                if ch and allowedLetter(ch) then
                    L = ch
                    break
                end
            end
        end
        if not L or anchorRegistry[L] then
            -- FIX: мёртвый слот (старая модель выгружена) не должен отвергать
            -- новый якорь с той же буквой навсегда.
            local old = L and anchorRegistry[L]
            if not (old and (not old.model or not old.model.Parent)) then return end
            anchorRegistry[L] = nil
        end
        local p = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
        if not p then return end
        anchorRegistry[L] = {model = m, part = p}
        pcall(function()
            if not m:FindFirstChild("M4_acl") then
                local tag = Instance.new("BoolValue")
                tag.Name = "M4_acl"
                tag.Parent = m
                m.Destroying:Connect(function()
                    if anchorRegistry[L] and anchorRegistry[L].model == m then anchorRegistry[L] = nil end
                    removeESPsForModel(m)
                end)
            end
        end)
        if anchorsESPEnabled then
            ManageESP(m, p, "Anchor " .. L, "anchor")
        end
    end

    -- поиск якорей в комнате (вызывается ПО СОБЫТИЮ добавления комнаты, один проход, с бюджетом)
    local function scanRoomForAnchors(r)
        if not r or not r:IsA("Model") then return end
        local stack, budget, processed = {r}, 6000, 0
        while #stack > 0 and budget > 0 do
            budget = budget - 1
            processed = processed + 1
            local node = table.remove(stack)
            if node:IsA("Model") then
                local ln = string.lower(node.Name)
                if ln:find("anchor") or ln:find("navanchor") or ln:find("winch") or ln:find("windlass") then
                    addAnchorModel(node)
                end
                for _, c in ipairs(node:GetChildren()) do
                if c:IsA("Model") then stack[#stack + 1] = c end
            end
            if processed % PERF.indexYieldEvery == 0 then task.wait() end
        end
        end
    end

    -- новая комната загрузилась -> сразу ищем в ней якоря (плюс проход по уже загруженным при старте)
    local anchorRoomConn
    local function hookRoomsForAnchors()
        if anchorRoomConn then return end
        local cr = workspace:FindFirstChild("CurrentRooms")
        if not cr then return end
        anchorRoomConn = cr.ChildAdded:Connect(function(r)
            if not HubActive then return end
            if not anchorQuestEnabled and not anchorsESPEnabled then return end
            task.spawn(function()
                task.wait(0.3)
                pcall(scanRoomForAnchors, r)
            end)
        end)
        for _, r in ipairs(cr:GetChildren()) do
            task.spawn(function()
                task.wait(0.2)
                pcall(scanRoomForAnchors, r)
            end)
        end
    end
    hookRoomsForAnchors()

    -- Grumble/Queen могут лежать в workspace.Status — слушаем по событиям (без сканов по кадрам)
    local statusConn
    local function hookStatusForMonsters()
        if statusConn then return end
        local st = workspace:FindFirstChild("Status")
        if not st then return end
        statusConn = st.ChildAdded:Connect(function(child)
            if not HubActive then return end
            task.spawn(function()
                task.wait(0.05)
