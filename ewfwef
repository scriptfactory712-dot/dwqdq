                end

                if odActiveDoorModel and (not odActiveDoorModel.Parent or not odActiveDoorPart or not odActiveDoorPart.Parent) then
                    odActiveDoorModel = nil
                    odActiveDoorPart = nil
                    odDoorArmed = false
                    ClearESPType("odDoor")
                end

