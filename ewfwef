local timothyCleanCache = setmetatable({}, {__mode = "k"})
local function containerHasTimothy(m)
    if not m then return false end
    if timothyCleanCache[m] then return false end
    local found = false
    pcall(function()
        for _, d in ipairs(m:GetDescendants()) do
            local ln = string.lower(d.Name)
            if ln:find("timothy") or ln:find("spider") then
                found = true
                return
            end
        end
    end)
    if not found then
        timothyCleanCache[m] = true
    end
    return found
end
local autoOpenPatterns = {
    "nightstand", "dresser", "desk", "chest", "drawer", "toolbox",
    "crate", "shelf", "sink", "table", "toolshed", "cabinet", "trash",
    "fireplace", "key rack", "keyrack", "item locker", "itemlocker",
    "mini locker", "minilocker", "mini-locker", "bookshelf",
    "container", "suitcase"
}
local function isContainerPrompt(prompt)
    local textOk = false
    local hideText = false
    pcall(function()
        local ot = string.lower(prompt.ObjectText or "")
        local at = string.lower(prompt.ActionText or "")
        if ot:find("search") or at:find("search") or ot:find("loot") or at:find("loot") then textOk = true end
        if ot:find("hide") or at:find("hide") then hideText = true end
    end)
    if hideText then return false end
    local anc = prompt.Parent
    for _ = 1, 4 do
        if not anc then break end
        local ln = string.lower(anc.Name)
        local compact = ln:gsub("[^%w]", "")
        if compact:find("itemlocker", 1, true) or compact:find("minilocker", 1, true) then return true end
        if ln:find("door") or ln:find("wardrobe") or ln:find("closet") or ln:find("cupboard")
            or ln:find("locker") or ln:find("bed") or ln:find("hideprompt")
            or ln:find("circularvent") or ln:find("gardencabinet") or ln:find("outhouse") then return false end
        if textOk then return true end
        for _, pat in ipairs(autoOpenPatterns) do
            if ln:find(pat) then return true end
        end
        anc = anc.Parent
    end
    return false
end

