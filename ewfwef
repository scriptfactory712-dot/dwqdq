    hookStatusForMonsters()

    -- папки CurrentRooms/Status могут появиться позже (запуск в лобби) — подпишемся на их появление
    local _anchorFolderConn = workspace.ChildAdded:Connect(function(c)
        if not HubActive then return end
        if c.Name == "CurrentRooms" and not anchorRoomConn then
            pcall(hookRoomsForAnchors)
        elseif c.Name == "Status" and not statusConn then
            pcall(hookStatusForMonsters)
        end
    end)

    -- терминал: MainTerminal / MainControlPanel (точные имена первыми, затем рекурсивный фолбек)
    local terminalCache = nil
    local lastTerminalScan = 0
    local function findTerminal()
        if terminalCache and terminalCache.Parent then return terminalCache end
        if os.clock() - lastTerminalScan < 1.5 then return nil end
        lastTerminalScan = os.clock()

        local exact, fallback = nil, nil
        for _, m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") then
                local ln = string.lower(m.Name)
                if ln:find("mainterminal") or ln:find("maincontrolpanel") then
                    exact = m
                    break
                end
                if not fallback and not ln:find("spawn") and not ln:find("template") then
                    if ln:find("controlpanel") or ln:find("control panel") or ln:find("main control")
                        or ln:find("maincomputer") or ln:find("main computer")
                        or ln:find("terminal") or ln:find("console") then
                        fallback = m
                    end
                end
            end
        end
        terminalCache = exact or fallback
        return terminalCache
    end

    -- читаем текущую цель: тексты на терминале (SurfaceGui/TextLabel/StringValue/атрибуты) + GameData
    local function readCurrentLetter()
        local term = findTerminal()
        if term then
            for _, d in ipairs(term:GetDescendants()) do
                local s = nil
                if d:IsA("StringValue") then s = d.Value
                elseif d:IsA("TextLabel") or d:IsA("TextBox") then s = d.Text
                end
                if type(s) == "string" and s ~= "" then
                    local L = letterFromText(s)
                    if L then return L end
                end
                local ok, a = pcall(function()
                    return d:GetAttribute("Anchor") or d:GetAttribute("CurrentAnchor")
                end)
                if ok and a then
                    local L = letterFromText(tostring(a))
                    if L then return L end
                end
            end
        end
        local gd = ReplicatedStorage:FindFirstChild("GameData")
        if gd then
            for _, v in ipairs(gd:GetChildren()) do
                local s = v:IsA("StringValue") and v.Value or nil
                if type(s) == "string" and s ~= "" then
                    local L = letterFromText(s)
                    if L then return L end
                end
                local ok, a = pcall(function()
                    return v:GetAttribute("Anchor") or v:GetAttribute("CurrentAnchor") or v:GetAttribute("Objective")
                end)
                if ok and a then
                    local L = letterFromText(tostring(a))
                    if L then return L end
                end
            end
        end
        return nil
    end

    -- красная кнопка: внутри терминала, либо модель верхнего уровня (имя/цвет)
    local function findRedButton(term)
        local function scanList(list)
            for _, m in ipairs(list) do
                for _, d in ipairs(m:GetDescendants()) do
                    local ln = string.lower(d.Name)
                    if ln:find("button") or ln:find("btn") then
                        if ln:find("red") then return d end
                        if d:IsA("BasePart") then
                            local col = d.Color
                            if col.R > 0.6 and col.G < 0.45 and col.B < 0.45 then return d end
                        end
                    end
                end
            end
            return nil
        end
        if term then
            local b = scanList({term})
            if b then return b end
        end
        return scanList(workspace:GetChildren())
    end

    -- главный цикл слежения (лёгкий, 1 раз в секунду, ничего не сканирует по кадрам)
    task.spawn(function()
        while HubActive do
            task.wait(1.0)
            pcall(function()
                -- 1) буквенные метки всех найденных якорей (идемпотентно, дубли не создаются)
                if anchorsESPEnabled then
                    for L, e in pairs(anchorRegistry) do
                        if e.model.Parent and e.part.Parent then
                            ManageESP(e.model, e.part, "Anchor " .. L, "anchor")
                        end
                    end
                end

                -- 2) quest-маркер текущей цели (только 2-й этаж)
                if not anchorQuestEnabled or getFloor() ~= 2 then
                    ClearESPType("anchorTarget")
                    ClearESPType("panelTarget")
                    lastTargetMode = nil
                    lastTargetLetter = nil
                    return
                end

                local currentLetter = readCurrentLetter()
                if not currentLetter then
                    -- фолбек: первый нерешённый якорь по порядку A→B→C→D→E→F→Z
                    for _, L in ipairs(ANCHOR_SEQ) do
                        local e = anchorRegistry[L]
                        if e and isAnchorSolved(e.model) ~= true then
                            currentLetter = L
                            break
                        end
                    end
                end

                local target = currentLetter and anchorRegistry[currentLetter]
                if target and target.model.Parent and target.part.Parent then
                    if lastTargetMode ~= "anchor" or lastTargetLetter ~= currentLetter then
                        ClearESPType("panelTarget")
                        ClearESPType("anchorTarget")
                        lastTargetMode = "anchor"
                        lastTargetLetter = currentLetter
                    end
                    ManageESP(target.model, target.part, "Anchor " .. currentLetter, "anchorTarget", true, "anchor")
                else
                    -- цели не видно (все решены / якорей пока нет) -> ведём к терминалу
                    local hasAny, allSolved = false, true
