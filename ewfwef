    -- чтобы не залагать и не спамить сервер.
    -- ВСЕГДА заблокированы: боковые Vacuum-двери (смерть) и сиденья.
    local openAllOn = false
    local openAllCats = {
        container = true, gold = true, item = true, puzzle = true, misc = true,
        door = false, hide = false, cart = false,
    }
    local openAllMaxDist = 0              -- 0 = без ограничения по дистанции
    local openAllCursor = 1               -- курсор обхода комнат
    local openAllFires = setmetatable({}, {__mode = "k"})
    local OPEN_ALL_ROOMS_PER_TICK = 3
    local OPEN_ALL_FIRES_PER_TICK = 8
    local OPEN_ALL_MAX_FIRES = 3          -- сколько раз максимум трогать один промпт
    local openAllPuzzleWords = {
        "lever", "valve", "wheel", "generator", "fuse", "breaker", "switch", "button",
        "crank", "pump", "engine", "handle", "hatch", "powerbox", "obtain", "hintpaper",
        "anchor", "terminal", "console", "computer",
    }
    local openAllItemWords = {"take", "pick", "grab", "equip"}
    -- Дешёвый предфильтр: дорогая Vacuum-проверка (атрибуты предков) нужна только дверям.
    -- У комнат-шаблонов DOORS RawName тоже может содержать "Vacuum", и без этого
    -- фильтра ящики внутри таких комнат блокировались бы вместе с боковыми дверями.
    local function openAllDoorish(prompt)
        local cur = prompt.Parent
        for _ = 1, 8 do
            if not cur then break end
            local n = string.lower(tostring(cur.Name or ""))
            if n:find("door", 1, true) or n:find("vacuum", 1, true) then return true end
            cur = cur.Parent
        end
        return false
    end

    local function openAllKind(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return nil end
        if not prompt.Parent or not prompt.Enabled then return nil end
        if openAllDoorish(prompt) and isVacuumDoorPrompt(prompt) then return nil end -- смерть, никогда
        if isHidingPrompt(prompt) then return openAllCats.hide and "hide" or nil end
        if DoorAssist.protected(prompt, nil) then return nil end     -- сиденья и прочее защищённое
        if isContainerPrompt(prompt) then return "container" end
        if IsGoldPrompt(prompt) then return "gold" end
        if DoorAssist.isCartPrompt(prompt) then return "cart" end
        if isDoorPrompt(prompt) then return "door" end
        local text = ""
        pcall(function()
            text = string.lower(tostring(prompt.ObjectText or "") .. " " .. tostring(prompt.ActionText or ""))
        end)
        if text ~= "" then
            for _, w in ipairs(openAllPuzzleWords) do
                if text:find(w, 1, true) then return "puzzle" end
            end
            for _, w in ipairs(openAllItemWords) do
                if text:find(w, 1, true) then return "item" end
            end
        end
        return "misc"
    end
