    local function odMatchesNamedItem(name, pats)
        local n = odNorm(name)
        for _, raw in ipairs(pats) do
            local p = odNorm(raw)
            if n == p or n == p .. "obtain" or n == p .. "pickup" or n:match("^" .. p .. "%d+$") then
