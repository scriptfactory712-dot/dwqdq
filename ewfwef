    local doorCloseQueue = {}
    task.spawn(function()
        while HubActive do
            task.wait(fpsBoost and (IS_MOBILE and 1.25 or 1) or PERF.autoOpenTick)
            pcall(function()
                local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not root then return end
                purgePromptCache()
                if autoOpenEnabled or autoDoorsEnabled or autoPickupEnabled or autoCoinEnabled then
                    -- Всегда добавляем ФИЗИЧЕСКУЮ комнату игрока: в Mines/Outdoors имена
                    -- комнат нечисловые, getNearbyRooms() их не возвращал, и авто-ящики
                    -- там не находили ни одного промпта.
                    local rooms = {}
                    local seenRoom = {}
                    local function addRoom(r)
                        if r and not seenRoom[r] then
                            seenRoom[r] = true
                            table.insert(rooms, r)
                        end
                    end
                    addRoom(DoorAssist.currentRoom())
                    for _, r in ipairs(getNearbyRooms()) do addRoom(r) end
                    if #rooms == 0 then
                        local roomFolder = workspace:FindFirstChild("CurrentRooms")
                        if roomFolder then
                            for _, r in ipairs(roomFolder:GetChildren()) do addRoom(r) end
                        end
                    end
                    local function handlePrompt(v, promptPos)
                        if autoDoorsEnabled and isDoorPrompt(v) then
                            local fired = FirePrompt(v, "autoDoor", autoOpenRadius)
                            if fired and autoCloseDoors then
                                local queued = false
                                for _, pending in ipairs(doorCloseQueue) do
                                    if pending.p == v then queued = true; break end
                                end
                                if not queued then table.insert(doorCloseQueue, {p = v, pos = promptPos}) end
                            end
                        end
                        -- isContainerPrompt сам отсекает двери, укрытия и сиденья, поэтому
                        -- вторая ветка (а не elseif) безопасна и не мешает дверям.
                        if autoOpenEnabled and isContainerPrompt(v) then
                            if antiTimothy and containerHasTimothy(v.Parent) then
                                -- skip
                            else
                                FirePrompt(v, "autoDrawer", autoOpenRadius)
                            end
                        end
                        if autoPickupEnabled and DoorAssist.isItemPickupPrompt(v) then
                            FirePrompt(v, "autoPickup", autoOpenRadius)
                        end
                        if autoCoinEnabled and IsGoldPrompt(v) then
                            FirePrompt(v, "autoPickup", autoCoinRadius)
                        end
                    end
                    for _, room in ipairs(rooms) do
                        for _, v in ipairs(getRoomPrompts(room)) do
                            local promptPos = v.Parent and promptWorldPosition(v) or nil
                            if promptPos and (promptPos - root.Position).Magnitude <= autoOpenRadius then
                                handlePrompt(v, promptPos)
                            end
                        end
                    end
                    -- Глобальный индекс: промпты, которых нет в комнатах (служебные папки,
                    -- префабы, лобби, мебель с составными именами).
                    for gp in pairs(globalPrompts) do
                        if gp.Parent then
                            -- Промпты уже просмотренных комнат есть и в globalPrompts.
                            -- Не классифицируем и не активируем их второй раз в тот же тик.
                            local ownerRoom = DoorAssist.roomOf(gp)
                            if not ownerRoom or not seenRoom[ownerRoom] then
                                local promptPos = promptWorldPosition(gp)
                                if promptPos and (promptPos - root.Position).Magnitude <= autoOpenRadius then
                                    handlePrompt(gp, promptPos)
                                end
                            end
                        else
                            globalPrompts[gp] = nil
                        end
                    end
                end
                if autoCloseDoors then
                    for i = #doorCloseQueue, 1, -1 do
