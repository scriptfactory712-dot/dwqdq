-- Удаляет ВСЕ ESP-элементы, привязанные к конкретной модели/парту
-- (используется для авто-очистки при Destroying/Unparented, чтобы не было утечек)
local function removeESPsForModel(model)
    if not model then return end
    for i = #ActiveESPs, 1, -1 do
        local e = ActiveESPs[i]
        if e.Model == model or e.Part == model then
            if e.Billboard then e.Billboard:Destroy() end
            if e.Highlight then e.Highlight:Destroy() end
            table.remove(ActiveESPs, i)
        end
    end
    clearModelTags(model, nil)
end

local function getNearbyRooms()
    local list = {}
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local latest = gameData and gameData:FindFirstChild("LatestRoom")
    local rawCurrent = latest and latest.Value or 0
    -- LatestRoom may be a number, "A-10" or a floor-prefixed string.
    -- Never pass the raw string to math.abs: that used to stop all auto-open loops.
    -- getCurrentRoom() здесь вызывать нельзя: локальная функция объявлена ниже,
    -- имя резолвилось в глобальную (nil) и роняло весь тик авто-открытия.
    local cur = tonumber(rawCurrent) or tonumber(tostring(rawCurrent):match("%d+")) or 0
    if workspace:FindFirstChild("CurrentRooms") then
        for _, r in ipairs(workspace.CurrentRooms:GetChildren()) do
            local n = tonumber(r.Name) or tonumber(tostring(r.Name):match("%d+"))
            if n and math.abs(n - cur) <= 1 then
                table.insert(list, r)
            end
        end
    end
    return list
end

local promptCache = setmetatable({}, {__mode = "k"})
local promptConns = setmetatable({}, {__mode = "k"})
local function getRoomPrompts(room)
    local c = promptCache[room]
    if not c then
        c = {}
        pcall(function()
            for _, v in ipairs(room:GetDescendants()) do
                if v:IsA("ProximityPrompt") then table.insert(c, v) end
            end
            local conn
            conn = room.DescendantAdded:Connect(function(v)
                if v:IsA("ProximityPrompt") then table.insert(c, v) end
            end)
            promptConns[room] = conn
            -- FIX утечки: коннект держал комнату в памяти вечно.
            -- Комната ушла — отписываемся и чистим кэш.
            room.Destroying:Connect(function()
                local cc = promptConns[room]
                if cc then pcall(function() cc:Disconnect() end) end
                promptConns[room] = nil
                promptCache[room] = nil
            end)
        end)
        promptCache[room] = c
    end
    return c
end

-- ProximityPrompt не имеет свойства Position. Позицию берём у Attachment/BasePart,
-- иначе старые авто-функции молча падали внутри pcall и ничего не делали.
local function promptWorldPosition(prompt)
    if not prompt then return nil end
    local parent = prompt.Parent
    if parent and parent:IsA("Attachment") then return parent.WorldPosition end
    if parent and parent:IsA("BasePart") then return parent.Position end
    local cur = parent
    for _ = 1, 5 do
        if not cur then break end
        if cur:IsA("Attachment") then return cur.WorldPosition end
        if cur:IsA("BasePart") then return cur.Position end
        cur = cur.Parent
    end
    -- FIX: промпт висит на Model без близких BasePart — берём центр bounding box,
    -- иначе позиция nil и FirePrompt вечно отказывает без единого сообщения.
    local ok, pos = pcall(function()
        local m = nil
        if parent and parent:IsA("Model") then
            m = parent
        elseif parent then
            m = parent:FindFirstAncestorOfClass("Model")
        end
        if m then return (m:GetBoundingBox()).Position end
        return nil
    end)
    if ok then return pos end
    return nil
end
local function purgePromptCache()
    for room in pairs(promptCache) do
        if not room.Parent then promptCache[room] = nil end
    end
end

-- ========== forEachEntityModel: workspace + все известные контейнеры + 1 уровень комнат ==========
local function forEachEntityModel(cb)
    local seen = {}
    local function emit(v)
        if v and v:IsA("Model") and not seen[v] then
            seen[v] = true
            cb(v)
        end
    end
    for _, v in pairs(workspace:GetChildren()) do
        emit(v)
    end
    for _, folderName in ipairs({"Entities", "Monsters", "Entity", "ActiveEntities", "Status"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, v in pairs(folder:GetChildren()) do emit(v) end
        end
    end
    if workspace:FindFirstChild("CurrentRooms") then
        for _, r in ipairs(workspace.CurrentRooms:GetChildren()) do
            for _, v in pairs(r:GetChildren()) do
                emit(v)
            end
        end
    end
end

local SpecialFoodList = {"Paper Plane", "PaperPlane", "Lunch Box", "LunchBox", "Fih Food", "FihFood", "Waiting Ticket", "WaitingTicket", "Mug", "Pack Of Gween Soda", "PackOfGweenSoda", "GweenSoda", "Paper Cup", "PaperCup"}
local HSListGlobal = {"Locker_Large", "Wardrobe", "Bed", "Backdoor_Wardrobe", "Rooms_Locker", "CircularVent", "Closet", "Cupboard", "Locker"}

local hideCache, hideCacheAt = nil, 0
local objCache, objCacheAt = nil, 0
local function nearestHiding()
    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    -- FIX лагов: полный обход комнат кэшируем на 2с (дёргают тики и события).
    local nowH = os.clock()
    if hideCache and nowH - hideCacheAt < 2
        and hideCache.Model and hideCache.Model.Parent
        and hideCache.Part and hideCache.Part.Parent then
        return hideCache
    end
    local best, bestD, bestM = nil, math.huge, nil
    pcall(function()
        for _, room in ipairs(getNearbyRooms()) do
            for _, v in ipairs(room:GetDescendants()) do
                if v:IsA("Model") then
                    for _, h in ipairs(HSListGlobal) do
                        if v.Name == h then
                            local p = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                            if p then
                                local d = (p.Position - root.Position).Magnitude
                                if d < bestD then bestD, bestM, best = d, v, p end
                            end
                            break
                        end
                    end
                end
            end
        end
    end)
    if best then
        hideCache = {Model = bestM, Part = best, Dist = bestD}
        hideCacheAt = os.clock()
        return hideCache
    end
    return nil
end

local objPromptKeywords = {"lever", "wheel", "valve", "generator", "fuse", "breaker", "minecart", "cart", "power", "anchor", "winch"}
local function nearestObjective()
    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    if not workspace:FindFirstChild("CurrentRooms") then return nil end
    -- FIX лагов: обход ±5 комнат кэшируем на 2с.
    local nowO = os.clock()
    if objCache and nowO - objCacheAt < 2 and objCache.pos then
        return objCache
    end
    local best, bestD = nil, math.huge
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local latest = gameData and gameData:FindFirstChild("LatestRoom")
    local cur = latest and latest.Value or 0
    for _, r in ipairs(workspace.CurrentRooms:GetChildren()) do
        local rn = tonumber(r.Name)
        if rn and math.abs(rn - cur) <= 5 then
            for _, v in ipairs(getRoomPrompts(r)) do
                if v.Parent then
                    local anc = v.Parent
                    local hit = false
                    for _ = 1, 3 do
                        if not anc then break end
                        local ln = string.lower(anc.Name)
                        for _, k in ipairs(objPromptKeywords) do
                            if ln:find(k) then
                                hit = true
                                break
                            end
                        end
                        if hit then break end
                        anc = anc.Parent
                    end
                    if hit then
                        local pos = promptWorldPosition(v)
                        local d = pos and (pos - root.Position).Magnitude or math.huge
                        if d < bestD then bestD = d; best = v end
                    end
                end
            end
        end
    end
    -- FIX: у промпта нет .Position — берём мировую позицию через хелпер,
    -- иначе ветка всегда падала и цель не показывалась.
    if best then
        local pp = promptWorldPosition(best)
        if pp then
            objCache = {pos = pp, dist = bestD}
            objCacheAt = os.clock()
            return objCache
        end
    end
    return nil
end

local function getCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local latest = gameData and gameData:FindFirstChild("LatestRoom")
    if not latest then return 0 end
    local direct = tonumber(latest.Value)
    if direct then return direct end
    return tonumber(tostring(latest.Value):match("%d+")) or 0
end

local function getFloor()
    local cur = getCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local floorName = ""
    if gameData then
        local floorValue = gameData:FindFirstChild("Floor")
        if floorValue then
            pcall(function() floorName = string.lower(tostring(floorValue.Value or "")) end)
        end
        if floorName == "" then
            pcall(function() floorName = string.lower(tostring(gameData:GetAttribute("Floor") or "")) end)
        end
    end
    if floorName == "" then
        pcall(function()
            floorName = string.lower(tostring(workspace:GetAttribute("Floor") or workspace:GetAttribute("FloorName") or ""))
        end)
    end
    if floorName == "" then
        for _, child in ipairs(workspace:GetChildren()) do
            local name = string.lower(tostring(child.Name or ""))
            if name == "stairwell" or name == "thestairwell" then floorName = "stairwell"; break end
        end
    end
    if floorName:find("backdoor") or cur < 0 then return 0 end
    if floorName:find("stairwell") or floorName:find("staircase") then return 5 end
    if floorName:find("archive") or floorName == "rooms" then return 4 end
    if floorName:find("mine") then return 2 end
    if floorName:find("outdoor") or floorName:find("garden") then return 3 end
    if floorName:find("hotel") then return 1 end
    if cur <= 100 then return 1 end
    if cur <= 200 then return 2 end
    return 3 -- THE OUTDOORS (сабфлор)
end

local function isInSeekChase()
    local cur = getCurrentRoom()
    return (cur >= 130 and cur <= 149) or (cur >= 170 and cur <= 180)
end

local function isSeekNear()
    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local function seekModelNear(m)
        if not m or not m:IsA("Model") then return false end
        local ln = string.lower(m.Name)
        local actorName = ln == "seek" or ln:find("seekmoving", 1, true)
            or ln:find("seekrig", 1, true) or ln:find("seekentity", 1, true)
        if actorName and not ln:find("door", 1, true) and not ln:find("eye", 1, true) then
            local bp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
            return bp ~= nil and (bp.Position - root.Position).Magnitude <= 160
        end
        return false
    end
    for _, m in pairs(workspace:GetChildren()) do
        if seekModelNear(m) then return true end
    end
    -- Некоторые версии DOORS держат сущность в отдельном контейнере.
    for _, folderName in ipairs({"Entities", "Monsters", "ActiveEntities", "Status"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                if seekModelNear(m) then return true end
            end
        end
    end
    return false
end

