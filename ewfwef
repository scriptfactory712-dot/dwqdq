    -- ========== VIP MINES ESP (Grumble / Queen / Giggle / Gloombats / Main Computer / Anchors A-E / Bulklight) ==========
    -- Один лёгкий поток + подписка на спавн. Ловит модели ЛЮБОЙ вложенности,
    -- не сканирует по кадрам, не пропадает (типы в PRIORITY_ESP не режутся).

    local vipSeen = setmetatable({}, {__mode = "k"})
    -- FIX лагов: счётчик перепроверок моделей без частей (вместо слипов).
    local vipRetry = setmetatable({}, {__mode = "k"})

    -- СТРОГОЕ определение мыши: только целые слова mouse/mice/rat (не "Ratchet", "Mousetrap" и пр.)
    local function isMouseName(n)
        local ln = string.lower(n or "")
        for token in string.gmatch(ln, "[%a]+") do
            if token == "mouse" or token == "mice" or token == "rat" then return true end
        end
        return false
    end

    local function vipKindOf(ln)
        if ln:find("queen") then return "queen" end
        if ln:find("grumble") then return "grumble" end
        if ln:find("giggle") then return "giggle" end
        if ln:find("gloombat") then return "gloombats" end
        if ln:find("maincomputer") or ln:find("main computer") or ln:find("console") or ln:find("terminal") or (ln:find("computer") and not ln:find("spawn")) then return "mainComputer" end
        if ln:find("figure") then return "figure" end
        if isMouseName(ln) then return "mouse" end
        if ln:find("bulklight") then return "bulklight" end
        return nil
    end

