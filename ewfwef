                end
            end)
        end
    end)

    local function odScanRoom(r)
        if not r or not r:IsA("Model") then return end
        local stack, budget, processed = {r}, 4000, 0
        while #stack > 0 and budget > 0 do
            budget = budget - 1
            processed = processed + 1
            local node = table.remove(stack)
            if node:IsA("Model") then odApply(node) end
            for _, c in ipairs(node:GetChildren()) do
                if c:IsA("Model") then stack[#stack + 1] = c end
            end
            if processed % PERF.indexYieldEvery == 0 then task.wait() end
        end
    end

