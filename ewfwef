    -- Простые проверки isContainerPrompt; нажатие сразу через FirePrompt,
    -- без классификаций, попыток и кэшей.
    local function isHidingPrompt(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return false end
        local promptText = ""
        pcall(function()
            promptText = string.lower(tostring(prompt.ObjectText or "") .. " " .. tostring(prompt.ActionText or ""))
        end)
        local promptCompact = promptText:gsub("[^%w]", "")
        local itemLockerText = promptCompact:find("itemlocker", 1, true)
            or promptCompact:find("minilocker", 1, true)
        if not itemLockerText and (promptText:find("hide", 1, true) or promptText:find("wardrobe", 1, true)
            or promptText:find("closet", 1, true) or promptText:find("locker", 1, true)) then
            return true
        end

        local cur = prompt.Parent
        for _ = 1, 12 do
            if not cur then break end
            local n = string.lower(tostring(cur.Name or "")):gsub("[^%w]", "")
            local itemLocker = n:find("itemlocker", 1, true) or n:find("minilocker", 1, true)
            if n:find("wardrobe", 1, true) or n:find("closet", 1, true)
                or n:find("cupboard", 1, true) or n:find("hiding", 1, true)
                or (n == "locker" and not itemLocker) or n:find("lockerlarge", 1, true)
                or n:find("roomslocker", 1, true) or n:find("circularvent", 1, true)
                or n:find("gardencabinet", 1, true) or n:find("outhouse", 1, true)
                or n == "bed" or n:find("backdoorwardrobe", 1, true) then
                return true
            end
            cur = cur.Parent
        end
        return false
    end

    local function roomRootFor(instance)
