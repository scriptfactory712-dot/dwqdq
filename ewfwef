    -- повторный вызов видит уже нужное значение и ничего не пишет.
    local speedConn, speedHum = nil, nil
    local function enforceSpeed(hum)
        if not HubActive or not speedBox.lock then return end
        if not hum or not hum.Parent then return end
        local target = speedBox.target
        local char = hum.Parent
        if slideBoostEnabled then
            pcall(function()
                if isSliding(char, hum) then target = slideSpeed end
            end)
        end
        local seekRunning = seekSpeedBoost and seekNearCached
        if seekRunning then
            target = math.max(target, seekBoostAmount)
        end
        -- В обычной игре прежний cap 20 сохраняется. Исключение действует только
        -- пока рядом действительно существует модель Seek; после исчезновения — 20.
        target = math.clamp(target, 10, seekRunning and 32 or 20)
        if hum.WalkSpeed ~= target then
            pcall(function() hum.WalkSpeed = target end)
        end
    end

