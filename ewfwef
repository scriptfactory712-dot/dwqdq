    local function hasVacuumMarker(instance)
        local cur = instance
        for _ = 1, 12 do
            if not cur then break end
            if string.lower(cur.Name or ""):find("vacuum") then return true end
            local rawName = nil
            pcall(function() rawName = cur:GetAttribute("RawName") end)
            if rawName and string.lower(tostring(rawName)):find("vacuum") then return true end
            cur = cur.Parent
        end
