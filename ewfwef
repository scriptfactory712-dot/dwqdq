    local autoCoinLoopStarted = false
    local function disconnectAutoCoin()
        for _, c in ipairs(autoCoinConns) do pcall(function() c:Disconnect() end) end
        autoCoinConns = {}
        autoCoinRooms = setmetatable({}, {__mode = "k"})
        goldPiles = setmetatable({}, {__mode = "k"})
        autoCoinStarted = false
    end
    local function watchGoldPile(goldPile)
        if goldPile and goldPile.Parent then goldPiles[goldPile] = true end
    end
    local function setupAutoCoinRoom(room)
        if not room or autoCoinRooms[room] then return end
        autoCoinRooms[room] = true
        -- FIX лагов: полный обход комнаты откладываем из критического пути
        -- стриминга; DescendantAdded ниже и так подхватывает новые GoldPile.
        task.spawn(function()
            task.wait(0.5)
            if not HubActive or not autoCoinEnabled then return end
            pcall(function()
                local stack, processed = {room}, 0
                while #stack > 0 and HubActive and autoCoinEnabled do
                    local node = table.remove(stack)
                    for _, v in ipairs(node:GetChildren()) do
                        if v:IsA("Model") and v.Name == "GoldPile" then watchGoldPile(v) end
                        stack[#stack + 1] = v
                        processed = processed + 1
                        if processed % PERF.indexYieldEvery == 0 then task.wait() end
                    end
                end
            end)
        end)
        local conn = room.DescendantAdded:Connect(function(v)
            if v:IsA("Model") and v.Name == "GoldPile" then
                task.spawn(function()
                    task.wait(0.05)
                    watchGoldPile(v)
                end)
            end
        end)
        table.insert(autoCoinConns, conn)
    end
    local function setAutoCoin(value)
        autoCoinEnabled = value
        if not value then disconnectAutoCoin() return end
        if autoCoinStarted then return end
        autoCoinStarted = true
        local rooms = workspace:FindFirstChild("CurrentRooms")
        if not rooms then
            autoCoinStarted = false
            task.delay(1, function() if HubActive and autoCoinEnabled then setAutoCoin(true) end end)
            return
        end
        for _, room in ipairs(rooms:GetChildren()) do setupAutoCoinRoom(room) end
        local c = rooms.ChildAdded:Connect(function(room)
            task.delay(0.2, function()
                if HubActive and autoCoinEnabled then setupAutoCoinRoom(room) end
            end)
        end)
        table.insert(autoCoinConns, c)
        if not autoCoinLoopStarted then
            autoCoinLoopStarted = true
            task.spawn(function()
                while HubActive do
                    task.wait(IS_MOBILE and 0.45 or 0.30)
                    if not autoCoinEnabled then continue end
                    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not root then continue end
                    local budget = IS_MOBILE and 5 or 9
                    for pile in pairs(goldPiles) do
                        if budget <= 0 then break end
                        if not pile.Parent then goldPiles[pile] = nil continue end
                        local prompt = pile:FindFirstChild("LootPrompt")
                            or pile:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and prompt.Parent and not prompt:GetAttribute("Interactions") then
                            local pos = promptWorldPosition(prompt)
                            if pos and (pos - root.Position).Magnitude <= autoCoinRadius then
                                if FirePrompt(prompt, "autoPickup", autoCoinRadius) then budget = budget - 1 end
                            end
                        end
                    end
                end
                autoCoinLoopStarted = false
            end)
        end
    end
