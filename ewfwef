    local function bdNorm(name)
        return string.lower(tostring(name or "")):gsub("[^%w]", "")
    end

    local function bdPart(model)
        if not model then return nil end
        if model:IsA("BasePart") then return model end
        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end

    local function bdIsTimerLever(model)
        local n = bdNorm(model and model.Name)
        return n:match("^timerlever%d*$") ~= nil
            or n:match("^hastelever%d*$") ~= nil
            or n:match("^backdoortimerlever%d*$") ~= nil
    end

    local function bdLeverBonus(model)
        for _, attr in ipairs({"Bonus", "Time", "Amount", "AddTime", "TimerBonus", "TimeAdded"}) do
            local value = nil
            pcall(function() value = tonumber(model:GetAttribute(attr)) end)
            if value == 15 or value == 30 or value == 60 then return value end
        end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local value = tonumber(tostring(d.Text or ""):match("%+%s*(%d+)"))
                if value == 15 or value == 30 or value == 60 then return value end
            end
        end
        return nil
    end

    local function bdLeverPrompt(model)
        return model and model:FindFirstChildWhichIsA("ProximityPrompt", true) or nil
    end

    local function bdLeverIsAvailable(model, prompt)
        for _, attr in ipairs({"Used", "Activated", "Pulled", "Completed"}) do
            local value = nil
            pcall(function() value = model:GetAttribute(attr) end)
            if value == true then return false end
        end
        if prompt then return prompt.Enabled end
        return true
    end

    local function bdIsStarlightVial(model)
        local n = bdNorm(model and model.Name)
        return n:match("^starlightvial%d*$") ~= nil
            or n:match("^vialofstarlight%d*$") ~= nil
    end

    local function bdIsRoomKey(model)
        local n = bdNorm(model and model.Name)
        return n:match("^keyobtain%d*$") ~= nil
            or n:match("^backdoorkey%d*$") ~= nil
            or n:match("^backdoorroomkey%d*$") ~= nil
            or n:match("^roomkey%d*$") ~= nil
    end

    local function bdIsGold(model)
        local n = bdNorm(model and model.Name)
        return n:match("^goldpile%d*$") ~= nil or n:match("^coinpile%d*$") ~= nil
    end

    local function bdIsHiding(model)
        local n = bdNorm(model and model.Name)
        return n:match("^backdoorwardrobe%d*$") ~= nil
            or n:match("^wardrobe%d*$") ~= nil
            or n:match("^closet%d*$") ~= nil
            or n:match("^locker%d*$") ~= nil
    end

    local function bdVacuumDoorName(name)
        local n = bdNorm(name)
        return n == "door" or n == "sidedoor" or n == "doorfake"
            or n == "vacuumdoor" or n:match("^door%d+$") ~= nil
            or n:match("^vacuumdoor%d*$") ~= nil
    end

    local function bdVacuumDoor(model)
        if not model or not model:IsA("Model") or not hasVacuumMarker(model) then return false end
        local n = bdNorm(model.Name)
        if not bdVacuumDoorName(n) then return false end
        local room = roomRootFor(model)
        if room and model.Parent == room and n == "door" then return false end

        -- A Vacuum assembly can contain another Model named Door. Mark only the
        -- outermost door assembly so one hazard never creates stacked ESP labels.
        local ancestor = model.Parent
        while ancestor and ancestor ~= room do
            if ancestor:IsA("Model") and bdVacuumDoorName(ancestor.Name) then return false end
            ancestor = ancestor.Parent
        end
        return true
    end

    -- FIX лагов Backdoor: полный GetDescendants + глубокий поиск частей +
    -- 12-уровневый обход атрибутов по каждой модели каждые 0.5с вешали большие
    -- комнаты (после ~11 двери). Кэшируем всё статичное, модели комнат — на 2с.
    local bdRoomCache = setmetatable({}, {__mode = "k"})
    local bdPartCache = setmetatable({}, {__mode = "k"})
    local bdVacCache = setmetatable({}, {__mode = "k"})
    local bdPromptCache = setmetatable({}, {__mode = "k"})
    local bdBonusCache = setmetatable({}, {__mode = "k"})
    local function bdCachedPart(model)
        local p = bdPartCache[model]
        if p and p.Parent then return p end
        p = bdPart(model)
        bdPartCache[model] = p
        return p
    end
    local function bdCachedVacuum(model)
        local v = bdVacCache[model]
        if v ~= nil then return v end
        v = bdVacuumDoor(model) == true
        bdVacCache[model] = v
        return v
    end
    local function bdRoomModels(room)
        local e = bdRoomCache[room]
        local now = os.clock()
        if e and now - e.at < 2 then return e.models end
        local models = {}
        pcall(function()
            for _, m in ipairs(room:GetDescendants()) do
                if m:IsA("Model") then models[#models + 1] = m end
            end
        end)
        bdRoomCache[room] = {at = now, models = models}
        return models
    end

    local function bdEntityKind(model)
        local n = bdNorm(model and model.Name)
        if n:find("backdoorrush", 1, true) or n:match("^blitz%d*$") then
            return "blitz", "BLITZ — HIDE!"
        elseif n:find("backdoorlookman", 1, true) or n:match("^lookman%d*$") then
            return "lookman", "LOOKMAN — DON'T LOOK"
        elseif (n:match("^haste%d*$") or n:find("hastemoving", 1, true)) and not n:find("lever", 1, true) then
            return "haste", "HASTE — FIND A LEVER!"
        elseif n:find("curiouslight", 1, true) then
            return "curiousLight", "CURIOUS LIGHT — SAFE"
        elseif n:find("glitch", 1, true) and not n:find("fragment", 1, true) then
            return "glitch", "GLITCH — STAY WITH THE GROUP"
        end
        return nil, nil
    end

    local function bdRoomType(room, roomNumber)
        if not room then return "Unknown room" end
        local raw = tostring(room:GetAttribute("RawName") or room.Name or "")
        local n = bdNorm(raw)
        local dark = n:find("dark", 1, true) ~= nil
        for _, attr in ipairs({"Dark", "DarkRoom", "IsDark"}) do
            if room:GetAttribute(attr) == true then dark = true end
        end

        local roomType
        if roomNumber == -51 or n:find("backdoorstart", 1, true) then
            roomType = "Room -51 — Back Entrance (safe, timer stopped)"
        elseif roomNumber == -50 or n:find("forcedlever", 1, true) or n:find("twogate", 1, true) then
            roomType = "Room -50 — Two Gates Room"
        elseif roomNumber == -1 or n:find("backdoorexit", 1, true) then
            roomType = "Room -01 — Vestibule / Curious Light portal"
        elseif n:find("multidoor", 1, true) or n:find("multigate", 1, true) then
            roomType = "Multi Gate Room — follow the correct numbered door"
        elseif n:find("crouch", 1, true) or n:find("wallroom", 1, true) then
            roomType = "The Wall Room — crouch route"
        elseif n:find("stair", 1, true) then
            roomType = "The Staircase Room — check corners for levers"
        elseif n:find("hallway", 1, true) or n:find("intersection", 1, true) or n:find("cross", 1, true) then
            roomType = "The Maintenance Hallway — many side doors"
        else
            roomType = "Standard Backdoor Room"
        end
        if dark then roomType = "Dark Room • " .. roomType end
        return roomType
    end

