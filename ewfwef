    DoorAssist.pickupNames = {
        key = true, lockpick = true, vitamins = true, lighter = true, flashlight = true,
        candle = true, crucifix = true, skeletonkey = true, battery = true, bandage = true,
        shears = true, bulklight = true, straplight = true, shakelight = true,
        laserpointer = true, starlight = true, bread = true, smoothie = true,
