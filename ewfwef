-- BEGIN DOOR ASSIST (also exercised by tests/verify.mjs)
-- A single owner for navigation, prompt safety and reversible instant-hold changes.
local DoorAssist = {
    fired = setmetatable({}, {__mode = "k"}),
    mobileDrawerPending = setmetatable({}, {__mode = "k"}),
    instantDurations = setmetatable({}, {__mode = "k"}),
    -- Промпт, который игра прямо сейчас показывает игроку (ведётся по
    -- PromptShown/PromptHidden). Нужен, чтобы клавиша E уходила именно в нашу цель,
    -- а не в дверь или укрытие, которое игра показывает рядом.
    -- Страховка для авто-ящиков: если API экзекьютора молчит, а игра показывает игроку
    -- другой промпт, всё равно разрешаем нажать клавишу промпта вплотную (см. FirePrompt).
    keyFallbackForDrawers = true,
    shownPrompt = nil,
    -- Последняя причина отказа FirePrompt/canFire (видно в probe). Без неё
    -- "авто-ящики не работают" нечем объяснить: все ветки молча возвращали false.
    lastFireReject = "",
}
function DoorAssist.normal(value)
    return string.lower(tostring(value or "")):gsub("[^%w]", "")
end
function DoorAssist.roomOf(instance)
    local rooms = workspace:FindFirstChild("CurrentRooms")
    while instance and instance ~= workspace do
        if instance.Parent == rooms then return instance end
        instance = instance.Parent
    end
    return nil
end
function DoorAssist.currentRoom()
    local character = LPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local rooms = workspace:FindFirstChild("CurrentRooms")
    if not root or not rooms then return nil end
    -- LatestRoom is team progress, not the room occupied by this player.
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hit = workspace:Raycast(root.Position, Vector3.new(0, -18, 0), params)
    local physicalRoom = hit and DoorAssist.roomOf(hit.Instance)
    if physicalRoom then return physicalRoom end
    -- Useful when airborne; do not fall back to a far generated room.
    local id = character:GetAttribute("CurrentRoom") or LPlayer:GetAttribute("CurrentRoom")
    local candidate = id ~= nil and rooms:FindFirstChild(tostring(id))
    if candidate and candidate:IsA("Model") then
        local cf, size = candidate:GetBoundingBox()
        local p = cf:PointToObjectSpace(root.Position)
        if math.abs(p.X) <= size.X / 2 + 2 and math.abs(p.Y) <= size.Y / 2 + 8
            and math.abs(p.Z) <= size.Z / 2 + 2 then return candidate end
    end
    return nil
end
function DoorAssist.protected(prompt, mode)
    local room = DoorAssist.roomOf(prompt)
    local current = prompt
    local hiding = false
    local action = DoorAssist.normal(tostring(prompt.ActionText or "") .. tostring(prompt.ObjectText or ""))
    if action == "sit" or action == "sitdown" or action == "takeaseat" then return true end
    -- Only the prompt's ancestor chain matters. Looking for any Seat below the
    -- nearest model blocked legitimate desk drawers when a chair was grouped as
    -- a sibling inside the same furniture model.
    while current and current ~= room and current ~= workspace do
        local n = DoorAssist.normal(current.Name)
        local itemLocker = n:find("itemlocker", 1, true) or n:find("minilocker", 1, true)
        pcall(function()
            if current:GetAttribute("Hiding") == true or current:GetAttribute("IsHidingSpot") == true
                or current:GetAttribute("Hide") == true then hiding = true end
        end)
        if current:IsA("Seat") or current:IsA("VehicleSeat")
            or n:find("chair", 1, true) or n:find("seat", 1, true) then return true end
        if n:find("wardrobe", 1, true) or n:find("closet", 1, true) or n:find("cupboard", 1, true)
            or (n:find("locker", 1, true) and not itemLocker) or n:find("hiding", 1, true)
            or n:find("gardencabinet", 1, true) or n:find("outhouse", 1, true)
            or n:find("bed", 1, true) or n == "hideprompt" or n == "circularvent" then hiding = true end
        current = current.Parent
    end
    if action:find("hide", 1, true) or action:find("enterhiding", 1, true) then hiding = true end
    -- Автоматическим путям нельзя входить в hiding spot ни при каком mode.
    -- Ручное игровое E не использует FirePrompt и продолжает работать.
    if hiding then return true end
    return false
end
-- Проверка "луч не перекрыт" для RequiresLineOfSight. Отдельная функция без замыканий:
-- canFire вызывается на каждый промпт каждый тик.
local function promptRayClear(fromPos, pos, prompt, params)
    local ray = workspace:Raycast(fromPos, pos - fromPos, params)
    if not ray then return true end
    if ray.Instance == prompt.Parent then return true end
    local owner = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
    return owner ~= DoorAssist.roomOf(prompt) and ray.Instance:IsDescendantOf(owner)
end
function DoorAssist.canFire(prompt, mode, radius)
    if not HubActive or not prompt or not prompt.Parent or not prompt:IsA("ProximityPrompt") then
        DoorAssist.lastFireReject = "noprompt"
        return false
    end
    if not prompt.Enabled then DoorAssist.lastFireReject = "disabled" return false end
    if DoorAssist.protected(prompt, mode) then DoorAssist.lastFireReject = "protected" return false end
    local root = LPlayer.Character and LPlayer.Character:FindFirstChild("HumanoidRootPart")
    local pos = promptWorldPosition(prompt)
    if not root then DoorAssist.lastFireReject = "noroot" return false end
    if not pos then DoorAssist.lastFireReject = "nopos" return false end
    -- globalOpen — открытие по всей карте: дистанцию ограничивает только явный лимит.
    -- autoDrawer работает через fireproximityprompt, где MaxActivationDistance промпта
    -- не проверяется, поэтому там тоже действует радиус хаба. Раньше
    -- math.min(prompt.MaxActivationDistance, radius) мог только СУЖАТЬ зону,
    -- и слайдер радиуса почти ни на что не влиял.
    local scriptReach = (mode == "globalOpen") or mode == "autoDoor" or mode == "autoPickup"
        or (mode == "autoDrawer" and type(fireproximityprompt) == "function")
    if scriptReach then
        if radius and radius > 0 and (pos - root.Position).Magnitude > radius then
            DoorAssist.lastFireReject = "dist"
            return false
        end
    else
        -- radius = 0 у слайдера означает «без лимита». Раньше ноль подставлялся прямо
        -- в math.min (в Lua 0 — истина!), лимит становился нулевым и промпт отклонялся
        -- всегда: так молча не работала категория «Пряталки» в OPEN EVERYTHING.
        local limit = prompt.MaxActivationDistance
        local wanted = tonumber(radius)
        if wanted and wanted > 0 then limit = math.min(limit, wanted) end
        if (pos - root.Position).Magnitude > limit then
            DoorAssist.lastFireReject = "dist"
            return false
        end
    end
    -- RequiresLineOfSight проверяет сама игра при настоящем вводе. Наш рейкаст давал
    -- ложные отказы: у камина луч упирается в кирпичи, у комода — в корпус, и авто-открытие
    -- молчало каждую секунду («отказ без нажатия»). Для авто-режимов LOS не проверяем.
    local losExempt = mode == "globalOpen" or mode == "autoDoor" or mode == "autoPickup"
        or mode == "manualE" or mode == "instantE"
        or mode == "autoLocker" or mode == "autoDrawer" or mode == "autoDrawerNative"
        or mode == "autoDrawerHold" or mode == "hardOpen"
    if prompt.RequiresLineOfSight and not losExempt then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LPlayer.Character}
        local camera = workspace.CurrentCamera
        local origin = camera and camera.CFrame.Position or root.Position
        if not promptRayClear(origin, pos, prompt, params) then
            -- Камера может смотреть сквозь стену или в другую сторону. Для авто-ящиков и
            -- ручного E даём второй шанс лучу от персонажа, иначе ящик рядом не откроется.
            if (mode == "autoDrawer" or mode == "autoDrawerNative" or mode == "autoDrawerHold"
                or mode == "autoLocker" or mode == "manualE")
                and promptRayClear(root.Position, pos, prompt, params) then
                -- луч от персонажа чист — продолжаем
            else
                DoorAssist.lastFireReject = "los"
                return false
            end
        end
    end
    return true
end
function DoorAssist.applyInstant(prompt)
    if not prompt or not prompt.Parent or not prompt:IsA("ProximityPrompt")
        or DoorAssist.protected(prompt, nil) then return false end
    if DoorAssist.instantDurations[prompt] == nil then
        DoorAssist.instantDurations[prompt] = prompt.HoldDuration
    end
    local ok = pcall(function() prompt.HoldDuration = 0 end)
    if not ok then DoorAssist.instantDurations[prompt] = nil end
    return ok
end
function DoorAssist.restoreInstant(prompt)
    local duration = DoorAssist.instantDurations[prompt]
    if duration == nil then return end
    DoorAssist.instantDurations[prompt] = nil
    if prompt and prompt.Parent then pcall(function() prompt.HoldDuration = duration end) end
end
function DoorAssist.restoreAllInstant()
    for prompt in pairs(DoorAssist.instantDurations) do DoorAssist.restoreInstant(prompt) end
end
function DoorAssist.isCartPrompt(prompt)
    local room = DoorAssist.roomOf(prompt)
    local current = prompt.Parent
    while current and current ~= room and current ~= workspace do
        local n = DoorAssist.normal(current.Name)
        if n == "minecart" or n == "cart" or n == "pushcart" then return true end
        current = current.Parent
    end
    return false
end
function DoorAssist.part(model)
    if model and model:IsA("BasePart") then return model end
    if model and model:IsA("Model") then
        local leaf = model:FindFirstChild("Door")
        if leaf and leaf:IsA("BasePart") then return leaf end
        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end
function DoorAssist.setTarget(kind, target, text)
    -- Remove by identity, not just number; equal labels may refer to different rooms.
    local retained = false
    for i = #ActiveESPs, 1, -1 do
        local entry = ActiveESPs[i]
        if entry.Type == kind then
            if retained or not target or entry.Model ~= target.model or entry.Part ~= target.part then
                if entry.Billboard then entry.Billboard:Destroy() end
                if entry.Highlight then entry.Highlight:Destroy() end
                table.remove(ActiveESPs, i)
            else
                retained = true
            end
        end
    end
    if target then ManageESP(target.model, target.part, text, kind, false) end
end
-- Нативное нажатие промпта: обнулённый HoldDuration + InputHoldBegin/End.
-- Между Begin и End ОБЯЗАТЕЛЕН кадр-пауза (раньше они шли подряд, удержание
-- отпускалось до обработки и промпт не срабатывал — это ломало весь фолбек).
-- Держим столько, сколько требует сам промпт: если игра вернёт своё значение
-- HoldDuration обратно, короткого тапа не хватит и удержание не досчитается.
function DoorAssist.nativeHoldPress(prompt, holdSeconds)
    if not prompt or not prompt.Parent then return false end
    local oldDuration = prompt.HoldDuration
    local ok = pcall(function()
        prompt.HoldDuration = 0
        prompt:InputHoldBegin()
        task.wait(math.max(0.08, tonumber(holdSeconds) or 0.12))
        prompt:InputHoldEnd()
        task.wait(0.03)
    end)
    -- Даже если Instance исчез во время wait или InputHoldEnd кинул ошибку,
    -- не оставляем HoldDuration навсегда нулевым.
    if prompt and prompt.Parent then pcall(function() prompt.HoldDuration = oldDuration end) end
    return ok
end

-- Один быстрый путь вместо 4x fireproximityprompt + PromptPressed + InputHold.
-- Старый вариант посылал до шести активаций на один ящик/дверь и делал task.wait
-- прямо внутри сканирующего потока — это и давало основной фриз при стриминге комнаты.
local function FirePrompt(prompt, mode, radius)
    if not prompt or not prompt.Parent then return false end
    -- Последний централизованный предохранитель. Даже если любой классификатор
    -- ошибочно назовёт шкаф предметом/золотом/дверью, автоматического E не будет.
    if DoorAssist.protected(prompt, nil) then
        DoorAssist.lastFireReject = "hiding-blocked"
        return false
    end
    if not DoorAssist.canFire(prompt, mode, radius) then return false end
    local nowF = os.clock()
    local cooldown = PERF.fireCooldown
    if mode == "autoDrawer" then cooldown = IS_MOBILE and 0.55 or 0.35 end
    if mode == "autoDoor" then cooldown = IS_MOBILE and 0.70 or 0.45 end
    if mode == "autoPickup" then cooldown = IS_MOBILE and 0.75 or 0.50 end
    if nowF - (DoorAssist.fired[prompt] or -10) < cooldown then return false end
    DoorAssist.fired[prompt] = nowF
    local touchDrawer = mode == "autoDrawer" and UserInputService.TouchEnabled
    if type(fireproximityprompt) == "function" then
        -- Некоторые мобильные executors молча игнорируют второй аргумент, но pcall
        -- всё равно возвращает true. На touch вызываем совместимую одноаргументную
        -- форму и ниже оставляем нативную страховку; ПК использует прежний быстрый путь.
        local ok
        if touchDrawer then
            ok = pcall(fireproximityprompt, prompt)
        else
            ok = pcall(fireproximityprompt, prompt, 0)
        end
        if ok and not touchDrawer then return true end
    end
    if touchDrawer then
        -- Один fallback на prompt: сканер и PromptShown могут найти один ящик вместе.
        -- Небольшая задержка даёт fireproximityprompt время отключить уже открытый
        -- prompt; если он остался активен, имитируем настоящее удержание на телефоне.
        if not DoorAssist.mobileDrawerPending[prompt] then
            DoorAssist.mobileDrawerPending[prompt] = true
            local hold = tonumber(prompt.HoldDuration) or 0.12
            task.delay(0.10, function()
                if HubActive and prompt and prompt.Parent and prompt.Enabled
                    and not DoorAssist.protected(prompt, nil) then
                    DoorAssist.nativeHoldPress(prompt, hold)
                end
                DoorAssist.mobileDrawerPending[prompt] = nil
            end)
        end
        return true
    end
    -- Executor без fireproximityprompt: нативный fallback не блокирует сканер.
    local hold = tonumber(prompt.HoldDuration) or 0.12
    task.defer(function()
        if HubActive and prompt and prompt.Parent then
            DoorAssist.nativeHoldPress(prompt, hold)
        end
    end)
    return true
end
